<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow py-6">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="bg-white p-4 rounded-sm shadow-sm border border-gray-200 flex items-center justify-between text-xs mb-4">
      <h1 class="text-base font-bold text-gray-900">My Wishlist (<%= products.length %> items)</h1>
      <a href="/products" class="text-blue-600 font-bold hover:underline">Explore More Products</a>
    </div>

    <% if (!products || products.length === 0) { %>
      <div class="bg-white p-12 text-center rounded-sm border border-gray-200">
        <i class="fa-regular fa-heart text-5xl text-gray-300 mb-3 block"></i>
        <h2 class="text-base font-bold text-gray-800">Empty Wishlist</h2>
        <p class="text-xs text-gray-500 mt-1 mb-4">You have no items in your wishlist. Start adding!</p>
        <a href="/products" class="bg-blue-600 text-white font-bold text-xs px-6 py-2 rounded">Browse Catalog</a>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <% products.forEach(product => { %>
          <div class="bg-white p-4 rounded-sm border border-gray-200 hover:shadow transition flex flex-col justify-between text-xs">
            <a href="/products/<%= product.slug %>" class="h-40 w-full flex items-center justify-center mb-2">
              <img src="<%= product.images && product.images[0] ? product.images[0] : '' %>" class="max-h-full max-w-full object-contain">
            </a>
            <div>
              <div class="font-semibold text-gray-800 line-clamp-2"><%= product.name %></div>
              <div class="font-bold text-gray-900 text-sm mt-1">
                <%= formatPrice(product.discountPrice > 0 ? product.discountPrice : product.price) %>
              </div>
            </div>
            <div class="mt-3 pt-2 border-t flex gap-2">
              <form action="/cart/add" method="POST" class="flex-1">
                <input type="hidden" name="productId" value="<%= product._id %>">
                <button type="submit" class="w-full bg-[#ff9f00] text-white font-bold py-1.5 rounded text-[11px]">
                  Add to Cart
                </button>
              </form>
              <form action="/wishlist/toggle" method="POST">
                <input type="hidden" name="productId" value="<%= product._id %>">
                <button type="submit" class="p-1.5 border rounded text-red-500 hover:bg-red-50" title="Remove">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
