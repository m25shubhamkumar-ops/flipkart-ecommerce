<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow py-4">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <div class="text-xs text-gray-500 mb-3 flex items-center gap-1.5">
      <a href="/" class="hover:text-blue-600">Home</a>
      <i class="fa-solid fa-chevron-right text-[9px]"></i>
      <a href="/products" class="hover:text-blue-600">Products</a>
      <% if (selectedCategory) { %>
        <i class="fa-solid fa-chevron-right text-[9px]"></i>
        <span class="text-gray-800 font-medium"><%= selectedCategory.name %></span>
      <% } %>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 items-start">
      
      <!-- Filters Sidebar (1 Column) -->
      <div class="bg-white p-4 rounded-sm shadow-sm border border-gray-200 sticky top-20">
        <div class="flex items-center justify-between border-b pb-3 mb-4">
          <h2 class="text-base font-bold text-gray-900 uppercase tracking-wide">Filters</h2>
          <a href="/products" class="text-xs text-blue-600 font-bold hover:underline">CLEAR ALL</a>
        </div>

        <form action="/products" method="GET" id="filterForm" class="space-y-5 text-xs text-gray-700">
          
          <!-- Preserve search if present -->
          <% if (query.search) { %>
            <input type="hidden" name="search" value="<%= query.search %>">
          <% } %>

          <!-- Categories Filter -->
          <div>
            <h3 class="font-bold text-gray-800 uppercase text-[11px] mb-2 tracking-wider">Category</h3>
            <div class="space-y-1.5 max-h-40 overflow-y-auto pr-1">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="category" value="" <%= !query.category ? 'checked' : '' %> onchange="this.form.submit()" class="text-blue-600">
                <span>All Categories</span>
              </label>
              <% allCategories.forEach(cat => { %>
                <label class="flex items-center gap-2 cursor-pointer hover:text-blue-600">
                  <input type="radio" name="category" value="<%= cat.slug %>" <%= query.category === cat.slug ? 'checked' : '' %> onchange="this.form.submit()" class="text-blue-600">
                  <span class="<%= query.category === cat.slug ? 'font-bold text-blue-600' : '' %>"><%= cat.name %></span>
                </label>
              <% }) %>
            </div>
          </div>

          <!-- Price Range Filter -->
          <div class="border-t pt-4">
            <h3 class="font-bold text-gray-800 uppercase text-[11px] mb-2 tracking-wider">Price Range</h3>
            <div class="flex items-center gap-2">
              <input type="number" name="minPrice" placeholder="Min ₹" value="<%= query.minPrice || '' %>" class="w-1/2 p-1.5 border border-gray-300 rounded text-xs">
              <span class="text-gray-400">to</span>
              <input type="number" name="maxPrice" placeholder="Max ₹" value="<%= query.maxPrice || '' %>" class="w-1/2 p-1.5 border border-gray-300 rounded text-xs">
            </div>
            <button type="submit" class="w-full mt-2 bg-blue-600 text-white font-bold py-1.5 rounded text-xs hover:bg-blue-700">
              Apply Price
            </button>
          </div>

          <!-- Brand Filter -->
          <% if (brands && brands.length > 0) { %>
            <div class="border-t pt-4">
              <h3 class="font-bold text-gray-800 uppercase text-[11px] mb-2 tracking-wider">Brand</h3>
              <div class="space-y-1.5 max-h-40 overflow-y-auto pr-1">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="radio" name="brand" value="" <%= !query.brand ? 'checked' : '' %> onchange="this.form.submit()" class="text-blue-600">
                  <span>All Brands</span>
                </label>
                <% brands.forEach(b => { %>
                  <label class="flex items-center gap-2 cursor-pointer hover:text-blue-600">
                    <input type="radio" name="brand" value="<%= b %>" <%= query.brand === b ? 'checked' : '' %> onchange="this.form.submit()" class="text-blue-600">
                    <span class="<%= query.brand === b ? 'font-bold text-blue-600' : '' %>"><%= b %></span>
                  </label>
                <% }) %>
              </div>
            </div>
          <% } %>

        </form>
      </div>

      <!-- Main Products Grid & Sort Header (3 Columns) -->
      <div class="lg:col-span-3 space-y-4">
        
        <!-- Header Bar with Sort Options -->
        <div class="bg-white p-3 sm:p-4 rounded-sm shadow-sm border border-gray-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
          <div>
            <h1 class="text-sm sm:text-base font-bold text-gray-800">
              <%= selectedCategory ? selectedCategory.name : (query.search ? `Search results for "${query.search}"` : 'All Products') %>
            </h1>
            <span class="text-gray-500 text-[11px]">(Showing <%= products.length %> of <%= totalProducts %> items)</span>
          </div>

          <!-- Sorting Links -->
          <div class="flex items-center gap-3 overflow-x-auto text-[11px]">
            <span class="font-bold text-gray-700 uppercase">Sort By:</span>
            <a href="/products?<%= new URLSearchParams({ ...query, sort: 'newest' }).toString() %>" class="<%= (!query.sort || query.sort === 'newest') ? 'text-blue-600 font-bold border-b-2 border-blue-600 pb-0.5' : 'text-gray-600 hover:text-blue-600' %>">
              Newest
            </a>
            <a href="/products?<%= new URLSearchParams({ ...query, sort: 'price_asc' }).toString() %>" class="<%= query.sort === 'price_asc' ? 'text-blue-600 font-bold border-b-2 border-blue-600 pb-0.5' : 'text-gray-600 hover:text-blue-600' %>">
              Price -- Low to High
            </a>
            <a href="/products?<%= new URLSearchParams({ ...query, sort: 'price_desc' }).toString() %>" class="<%= query.sort === 'price_desc' ? 'text-blue-600 font-bold border-b-2 border-blue-600 pb-0.5' : 'text-gray-600 hover:text-blue-600' %>">
              Price -- High to Low
            </a>
            <a href="/products?<%= new URLSearchParams({ ...query, sort: 'rating' }).toString() %>" class="<%= query.sort === 'rating' ? 'text-blue-600 font-bold border-b-2 border-blue-600 pb-0.5' : 'text-gray-600 hover:text-blue-600' %>">
              Customer Rating
            </a>
          </div>
        </div>

        <!-- Products Grid -->
        <% if (products && products.length > 0) { %>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            <% products.forEach(product => { %>
              <div class="bg-white p-4 rounded-sm border border-gray-200 hover:border-blue-400 hover:shadow-md transition flex flex-col justify-between group relative">
                
                <!-- Image -->
                <a href="/products/<%= product.slug %>" class="h-48 w-full flex items-center justify-center mb-3 overflow-hidden">
                  <img src="<%= product.images && product.images[0] ? product.images[0] : 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400' %>" 
                       alt="<%= product.name %>" 
                       class="max-h-full max-w-full object-contain group-hover:scale-105 transition duration-300">
                </a>

                <!-- Meta -->
                <div>
                  <div class="text-[10px] font-bold text-gray-400 uppercase tracking-wider"><%= product.brand %></div>
                  <a href="/products/<%= product.slug %>" class="text-xs font-semibold text-gray-800 group-hover:text-blue-600 line-clamp-2 leading-tight">
                    <%= product.name %>
                  </a>

                  <!-- Rating -->
                  <div class="flex items-center gap-1.5 mt-2">
                    <span class="inline-flex items-center gap-0.5 bg-[#388e3c] text-white text-[10px] font-bold px-1.5 py-0.5 rounded">
                      <%= product.ratingAvg || 4.1 %> <i class="fa-solid fa-star text-[8px]"></i>
                    </span>
                    <span class="text-[11px] text-gray-500">(<%= product.ratingCount || 45 %>)</span>
                    <img src="https://static-assets-web.flixcart.com/fk-p-linchpin-web/fk-cp-zion/img/fa_62673a.png" alt="Flipkart Assured" class="h-3.5 object-contain ml-auto">
                  </div>

                  <!-- Price -->
                  <div class="flex items-baseline gap-2 mt-2">
                    <span class="text-sm font-bold text-gray-900">
                      <%= formatPrice(product.discountPrice > 0 ? product.discountPrice : product.price) %>
                    </span>
                    <% if (product.discountPrice > 0 && product.discountPrice < product.price) { %>
                      <span class="text-[11px] text-gray-400 line-through"><%= formatPrice(product.price) %></span>
                      <span class="text-[11px] font-bold text-emerald-600">
                        <%= Math.round(((product.price - product.discountPrice) / product.price) * 100) %>% off
                      </span>
                    <% } %>
                  </div>

                  <div class="text-[10px] text-emerald-700 font-semibold mt-1">
                    <%= product.stock > 0 ? 'In stock' : 'Out of stock' %>
                  </div>
                </div>

                <!-- Add to Cart / Details -->
                <div class="mt-3 pt-2 border-t border-gray-100 flex gap-2">
                  <a href="/products/<%= product.slug %>" class="flex-1 text-center bg-gray-100 hover:bg-gray-200 text-gray-800 text-[11px] font-semibold py-1.5 rounded transition">
                    View
                  </a>
                  <form action="/cart/add" method="POST" class="flex-1">
                    <input type="hidden" name="productId" value="<%= product._id %>">
                    <button type="submit" <%= product.stock <= 0 ? 'disabled' : '' %> class="w-full bg-[#ff9f00] hover:bg-[#f39700] text-white text-[11px] font-bold py-1.5 rounded transition disabled:opacity-50">
                      Add to Cart
                    </button>
                  </form>
                </div>

              </div>
            <% }) %>
          </div>

          <!-- Pagination -->
          <% if (totalPages > 1) { %>
            <div class="bg-white p-4 rounded-sm border border-gray-200 flex items-center justify-between text-xs">
              <div>
                Page <%= currentPage %> of <%= totalPages %>
              </div>
              <div class="flex items-center gap-1">
                <% if (currentPage > 1) { %>
                  <a href="/products?<%= new URLSearchParams({ ...query, page: currentPage - 1 }).toString() %>" class="px-3 py-1.5 border rounded hover:bg-gray-100 font-bold">
                    Previous
                  </a>
                <% } %>
                
                <% for (let p = 1; p <= totalPages; p++) { %>
                  <a href="/products?<%= new URLSearchParams({ ...query, page: p }).toString() %>" class="px-3 py-1.5 border rounded <%= p === currentPage ? 'bg-blue-600 text-white font-bold' : 'hover:bg-gray-100' %>">
                    <%= p %>
                  </a>
                <% } %>

                <% if (currentPage < totalPages) { %>
                  <a href="/products?<%= new URLSearchParams({ ...query, page: currentPage + 1 }).toString() %>" class="px-3 py-1.5 border rounded hover:bg-gray-100 font-bold">
                    Next
                  </a>
                <% } %>
              </div>
            </div>
          <% } %>

        <% } else { %>
          <!-- No Results -->
          <div class="bg-white p-12 text-center rounded-sm border border-gray-200">
            <div class="w-20 h-20 mx-auto mb-4 text-gray-300">
              <i class="fa-solid fa-box-open text-6xl"></i>
            </div>
            <h3 class="text-base font-bold text-gray-800 mb-1">No products found</h3>
            <p class="text-xs text-gray-500 mb-4">Try checking your spelling or adjusting your search filters.</p>
            <a href="/products" class="inline-block bg-blue-600 text-white text-xs font-bold px-6 py-2 rounded">
              Clear All Filters
            </a>
          </div>
        <% } %>

      </div>

    </div>

  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
