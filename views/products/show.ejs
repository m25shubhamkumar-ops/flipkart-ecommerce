<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow py-4">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Breadcrumb -->
    <div class="text-xs text-gray-500 mb-3 flex items-center gap-1.5">
      <a href="/" class="hover:text-blue-600">Home</a>
      <i class="fa-solid fa-chevron-right text-[9px]"></i>
      <a href="/products" class="hover:text-blue-600">Products</a>
      <% if (product.categoryId) { %>
        <i class="fa-solid fa-chevron-right text-[9px]"></i>
        <a href="/products?category=<%= product.categoryId.slug %>" class="hover:text-blue-600"><%= product.categoryId.name %></a>
      <% } %>
      <i class="fa-solid fa-chevron-right text-[9px]"></i>
      <span class="text-gray-800 font-medium truncate max-w-xs"><%= product.name %></span>
    </div>

    <!-- Product Card Container -->
    <div class="bg-white rounded-sm shadow-sm border border-gray-200 p-6 grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Left Column: Images and CTA Buttons (5 cols) -->
      <div class="lg:col-span-5 flex flex-col items-center">
        
        <!-- Main Image -->
        <div class="w-full h-80 sm:h-96 flex items-center justify-center p-4 border border-gray-100 rounded-sm mb-4">
          <img id="mainImage" 
               src="<%= product.images && product.images[0] ? product.images[0] : 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600' %>" 
               alt="<%= product.name %>" 
               class="max-h-full max-w-full object-contain">
        </div>

        <!-- Thumbnails -->
        <% if (product.images && product.images.length > 1) { %>
          <div class="flex items-center gap-2 mb-6">
            <% product.images.forEach((img, idx) => { %>
              <button onclick="document.getElementById('mainImage').src='<%= img %>'" class="w-14 h-14 border border-gray-200 hover:border-blue-500 p-1 rounded overflow-hidden focus:ring-2 focus:ring-blue-400">
                <img src="<%= img %>" alt="Thumbnail" class="w-full h-full object-contain">
              </button>
            <% }) %>
          </div>
        <% } %>

        <!-- Buttons: Add to Cart and Buy Now -->
        <div class="w-full flex gap-3 mt-auto">
          <button 
            type="button" 
            id="addToCartBtn"
            onclick="handleAddToCart('<%= product._id %>', this)"
            <%= product.stock <= 0 ? 'disabled' : '' %> 
            class="flex-1 bg-[#ff9f00] hover:bg-[#f39700] text-white font-bold py-3 px-4 rounded-sm text-sm uppercase tracking-wider shadow flex items-center justify-center gap-2 disabled:opacity-50 transition-colors"
          >
            <i class="fa-solid fa-cart-shopping"></i> Add to Cart
          </button>

          <form action="/cart/add" method="POST" class="flex-1">
            <input type="hidden" name="productId" value="<%= product._id %>">
            <input type="hidden" name="buyNow" value="true">
            <button type="submit" <%= product.stock <= 0 ? 'disabled' : '' %> class="w-full bg-[#fb641b] hover:bg-[#ea550d] text-white font-bold py-3 px-4 rounded-sm text-sm uppercase tracking-wider shadow flex items-center justify-center gap-2 disabled:opacity-50">
              <i class="fa-solid fa-bolt"></i> Buy Now
            </button>
          </form>
        </div>

        <!-- Inline Toast Alert Container -->
        <div id="cartToast" class="hidden w-full mt-2 p-2.5 bg-emerald-50 border border-emerald-300 rounded text-emerald-800 text-xs font-semibold text-center flex items-center justify-center gap-2">
          <i class="fa-solid fa-circle-check text-emerald-600"></i>
          <span id="cartToastMsg">Item added to cart! It will stay until you remove it.</span>
        </div>


        <!-- Wishlist toggle -->
        <div class="w-full mt-3 text-center">
          <form action="/wishlist/toggle" method="POST">
            <input type="hidden" name="productId" value="<%= product._id %>">
            <button type="submit" class="text-xs font-semibold text-gray-600 hover:text-red-500 inline-flex items-center gap-1.5">
              <i class="<%= inWishlist ? 'fa-solid fa-heart text-red-500' : 'fa-regular fa-heart' %>"></i>
              <%= inWishlist ? 'Remove from Wishlist' : 'Add to Wishlist' %>
            </button>
          </form>
        </div>

      </div>

      <!-- Right Column: Product Info & Pricing (7 cols) -->
      <div class="lg:col-span-7 space-y-4">
        
        <div>
          <span class="text-xs font-bold text-gray-400 uppercase tracking-widest"><%= product.brand %></span>
          <h1 class="text-xl sm:text-2xl font-bold text-gray-900 mt-1">
            <%= product.name %>
          </h1>
        </div>

        <!-- Rating & Assured Badge -->
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-1 bg-[#388e3c] text-white text-xs font-bold px-2 py-0.5 rounded">
            <span><%= product.ratingAvg || 4.2 %></span>
            <i class="fa-solid fa-star text-[10px]"></i>
          </div>
          <span class="text-xs text-gray-500 font-medium"><%= product.ratingCount || 34 %> Ratings & Reviews</span>
          <img src="https://static-assets-web.flixcart.com/fk-p-linchpin-web/fk-cp-zion/img/fa_62673a.png" alt="Flipkart Assured" class="h-5 object-contain">
        </div>

        <!-- Price Section -->
        <div class="pt-2 border-t border-gray-100">
          <div class="flex items-baseline gap-3">
            <span class="text-3xl font-black text-gray-900">
              <%= formatPrice(product.discountPrice > 0 ? product.discountPrice : product.price) %>
            </span>
            <% if (product.discountPrice > 0 && product.discountPrice < product.price) { %>
              <span class="text-base text-gray-400 line-through">
                <%= formatPrice(product.price) %>
              </span>
              <span class="text-base font-bold text-emerald-600">
                <%= Math.round(((product.price - product.discountPrice) / product.price) * 100) %>% off
              </span>
            <% } %>
          </div>
          <p class="text-[11px] text-gray-500 mt-1">+ ₹40 Secured Packaging Fee (Free delivery above ₹500)</p>
        </div>

        <!-- Stock Status -->
        <div>
          <% if (product.stock > 10) { %>
            <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-1 rounded">
              <i class="fa-solid fa-check-circle"></i> In Stock (Fast Delivery Available)
            </span>
          <% } else if (product.stock > 0) { %>
            <span class="text-xs font-bold text-amber-600 bg-amber-50 px-2 py-1 rounded">
              <i class="fa-solid fa-triangle-exclamation"></i> Only <%= product.stock %> left in stock!
            </span>
          <% } else { %>
            <span class="text-xs font-bold text-red-600 bg-red-50 px-2 py-1 rounded">
              <i class="fa-solid fa-circle-xmark"></i> Currently Out of Stock
            </span>
          <% } %>
        </div>

        <!-- Available Offers -->
        <div class="bg-gray-50 p-4 rounded-sm border border-gray-200 text-xs space-y-2">
          <h3 class="font-bold text-gray-800 uppercase tracking-wide text-[11px]">Available Offers</h3>
          <p class="text-gray-700 flex items-start gap-2">
            <i class="fa-solid fa-tag text-emerald-600 mt-0.5"></i>
            <span><strong>Bank Offer:</strong> 5% Unlimited Cashback on Flipkart Axis Bank Card</span>
          </p>
          <p class="text-gray-700 flex items-start gap-2">
            <i class="fa-solid fa-tag text-emerald-600 mt-0.5"></i>
            <span><strong>Special Price:</strong> Get extra 10% off on this product (price inclusive of cashback)</span>
          </p>
          <p class="text-gray-700 flex items-start gap-2">
            <i class="fa-solid fa-tag text-emerald-600 mt-0.5"></i>
            <span><strong>Partner Offer:</strong> Sign up for Flipkart Pay Later & get free shipping</span>
          </p>
        </div>

        <!-- Description -->
        <div class="pt-4 border-t border-gray-100">
          <h3 class="text-sm font-bold text-gray-900 mb-2">Product Description</h3>
          <p class="text-xs text-gray-700 leading-relaxed whitespace-pre-line">
            <%= product.description %>
          </p>
        </div>

      </div>

    </div>

    <!-- Ratings & Reviews Section -->
    <div class="bg-white rounded-sm shadow-sm border border-gray-200 p-6 mt-4">
      <div class="flex items-center justify-between border-b pb-4 mb-6">
        <div>
          <h2 class="text-lg font-bold text-gray-900">Ratings & Reviews</h2>
          <div class="flex items-center gap-2 mt-1">
            <span class="bg-[#388e3c] text-white text-xs font-bold px-2 py-0.5 rounded">
              <%= product.ratingAvg || 4.2 %> ★
            </span>
            <span class="text-xs text-gray-500">Based on <%= reviews.length %> customer review(s)</span>
          </div>
        </div>
      </div>

      <!-- Write a Review Form (Only for verified purchasers) -->
      <% if (canReview) { %>
        <div class="bg-blue-50 border border-blue-200 rounded p-4 mb-6">
          <h3 class="text-sm font-bold text-blue-900 mb-2">You purchased this product! Leave a review:</h3>
          <form action="/products/<%= product._id %>/reviews" method="POST" class="space-y-3 text-xs">
            <div>
              <label class="block font-semibold mb-1 text-gray-700">Rating (1 to 5 Stars):</label>
              <select name="rating" required class="p-2 border rounded bg-white text-xs font-bold">
                <option value="5">⭐⭐⭐⭐⭐ (5 Stars - Excellent)</option>
                <option value="4">⭐⭐⭐⭐ (4 Stars - Good)</option>
                <option value="3">⭐⭐⭐ (3 Stars - Average)</option>
                <option value="2">⭐⭐ (2 Stars - Below Average)</option>
                <option value="1">⭐ (1 Star - Poor)</option>
              </select>
            </div>
            <div>
              <label class="block font-semibold mb-1 text-gray-700">Review Title (Optional):</label>
              <input type="text" name="title" placeholder="e.g. Great value for money" class="w-full p-2 border rounded">
            </div>
            <div>
              <label class="block font-semibold mb-1 text-gray-700">Detailed Review:</label>
              <textarea name="comment" rows="3" required placeholder="Share your experience with this item..." class="w-full p-2 border rounded"></textarea>
            </div>
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-5 py-2 rounded text-xs">
              Submit Review
            </button>
          </form>
        </div>
      <% } %>

      <!-- Reviews List -->
      <% if (reviews && reviews.length > 0) { %>
        <div class="space-y-4 divide-y divide-gray-100">
          <% reviews.forEach(rev => { %>
            <div class="pt-4 first:pt-0">
              <div class="flex items-center gap-2">
                <span class="bg-[#388e3c] text-white text-[10px] font-bold px-1.5 py-0.5 rounded">
                  <%= rev.rating %> ★
                </span>
                <span class="text-xs font-bold text-gray-800"><%= rev.title || 'Verified Purchase' %></span>
              </div>
              <p class="text-xs text-gray-700 mt-2 leading-relaxed"><%= rev.comment %></p>
              <div class="flex items-center gap-2 mt-2 text-[11px] text-gray-400">
                <span class="font-medium text-gray-600"><%= rev.userId ? rev.userId.name : 'Customer' %></span>
                <span>•</span>
                <span class="text-emerald-600 font-semibold"><i class="fa-solid fa-circle-check text-[10px]"></i> Certified Buyer</span>
                <span>•</span>
                <span><%= new Date(rev.createdAt).toLocaleDateString('en-IN', { month: 'short', year: 'numeric' }) %></span>
              </div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="text-xs text-gray-500 italic py-4">No reviews submitted yet for this product. Be the first to buy and review!</p>
      <% } %>

    </div>
  </div>
</main>

<script>
  async function handleAddToCart(productId, btn) {
    if (btn.dataset.inCart === 'true') {
      window.location.href = '/cart';
      return;
    }

    const origHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Adding...';

    try {
      const res = await fetch('/cart/add', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ productId, quantity: 1, ajax: 'true' })
      });

      const data = await res.json();
      if (data.success) {
        // Change button to "GO TO CART"
        btn.disabled = false;
        btn.dataset.inCart = 'true';
        btn.className = 'flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-4 rounded-sm text-sm uppercase tracking-wider shadow flex items-center justify-center gap-2 transition-colors';
        btn.innerHTML = '<i class="fa-solid fa-check"></i> Go to Cart';

        // Update header cart badge
        const badges = document.querySelectorAll('header a[href="/cart"] span');
        badges.forEach(b => {
          b.innerText = data.count;
          b.style.display = 'flex';
        });

        // Show toast
        const toast = document.getElementById('cartToast');
        const toastMsg = document.getElementById('cartToastMsg');
        if (toast && toastMsg) {
          toastMsg.innerText = data.message || 'Added to cart! Item will stay in your cart.';
          toast.classList.remove('hidden');
        }
      } else {
        alert(data.message || 'Could not add to cart.');
        btn.disabled = false;
        btn.innerHTML = origHtml;
      }
    } catch (err) {
      console.error('Cart add error:', err);
      // Fallback
      window.location.href = '/cart';
    }
  }
</script>

<%- include('../partials/footer') %>
</body>
</html>

