<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow py-6">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex items-center justify-between mb-4">
      <h1 class="text-xl font-bold text-gray-900">My Orders (<%= orders.length %>)</h1>
      <a href="/products" class="text-xs text-blue-600 font-bold hover:underline">Continue Shopping</a>
    </div>

    <% if (!orders || orders.length === 0) { %>
      <div class="bg-white p-12 text-center rounded-sm shadow-sm border border-gray-200">
        <div class="w-24 h-24 mx-auto mb-4 text-gray-300">
          <i class="fa-solid fa-box-open text-6xl"></i>
        </div>
        <h2 class="text-base font-bold text-gray-800">You have not placed any orders yet</h2>
        <p class="text-xs text-gray-500 mt-1 mb-6">Browse our top deals and order your favorite products today.</p>
        <a href="/products" class="inline-block bg-[#2874f0] text-white font-bold text-xs px-8 py-2.5 rounded shadow">
          Start Shopping
        </a>
      </div>
    <% } else { %>
      
      <div class="space-y-4">
        <% orders.forEach(order => { %>
          <div class="bg-white rounded-sm shadow-sm border border-gray-200 hover:border-blue-400 transition p-4 sm:p-5">
            
            <!-- Order Header -->
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-gray-100 pb-3 mb-3 text-xs">
              <div class="flex items-center gap-3">
                <span class="font-bold text-gray-800">Order #<%= order.orderNumber %></span>
                <span class="text-gray-400">|</span>
                <span class="text-gray-500">Placed on <%= formatDate(order.createdAt) %></span>
              </div>

              <!-- Status Badge -->
              <div>
                <% if (order.orderStatus === 'Delivered') { %>
                  <span class="inline-flex items-center gap-1.5 text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full font-bold text-xs">
                    <span class="w-2 h-2 rounded-full bg-emerald-600"></span> Delivered
                  </span>
                <% } else if (order.orderStatus === 'Cancelled') { %>
                  <span class="inline-flex items-center gap-1.5 text-red-700 bg-red-50 px-2.5 py-1 rounded-full font-bold text-xs">
                    <span class="w-2 h-2 rounded-full bg-red-600"></span> Cancelled
                  </span>
                <% } else if (order.orderStatus && order.orderStatus.startsWith('Return')) { %>
                  <span class="inline-flex items-center gap-1.5 text-amber-800 bg-amber-50 px-2.5 py-1 rounded-full font-bold text-xs border border-amber-200">
                    <span class="w-2 h-2 rounded-full bg-amber-500"></span> <%= order.orderStatus %>
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1.5 text-blue-700 bg-blue-50 px-2.5 py-1 rounded-full font-bold text-xs">
                    <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span> <%= order.orderStatus %>
                  </span>
                <% } %>
              </div>
            </div>

            <!-- Items preview -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
              
              <div class="md:col-span-8 space-y-3">
                <% order.items.forEach(item => { %>
                  <div class="flex items-center gap-3">
                    <div class="w-14 h-14 border rounded p-1 flex-shrink-0 flex items-center justify-center">
                      <img src="<%= item.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=100' %>" class="max-h-full max-w-full object-contain">
                    </div>
                    <div class="text-xs">
                      <div class="font-medium text-gray-900 line-clamp-1"><%= item.name %></div>
                      <div class="text-gray-500">Qty: <%= item.quantity %> • <%= formatPrice(item.discountPrice || item.price) %> each</div>
                    </div>
                  </div>
                <% }) %>
              </div>

              <div class="md:col-span-4 flex flex-col sm:items-end justify-center border-t md:border-t-0 md:border-l md:pl-4 pt-3 md:pt-0">
                <div class="text-xs text-gray-500">Total Amount</div>
                <div class="text-base font-black text-gray-900"><%= formatPrice(order.totals.grandTotal) %></div>
                <div class="text-[11px] text-gray-500 mt-0.5">Mode: <strong class="uppercase text-gray-700"><%= order.paymentMethod %></strong></div>
                
                <a href="/orders/<%= order._id %>" class="mt-3 inline-flex items-center gap-1 text-xs font-bold text-blue-600 hover:text-blue-800">
                  Track & View Details <i class="fa-solid fa-chevron-right text-[10px]"></i>
                </a>
              </div>

            </div>

          </div>
        <% }) %>
      </div>

    <% } %>

  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
