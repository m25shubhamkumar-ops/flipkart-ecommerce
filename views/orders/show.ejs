<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow py-6">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    
    <% if (isNewlyPlaced) { %>
      <div class="bg-emerald-50 border-l-4 border-emerald-500 p-4 rounded-r shadow-sm flex items-center gap-3">
        <i class="fa-solid fa-circle-check text-emerald-600 text-2xl"></i>
        <div>
          <h2 class="text-sm font-bold text-emerald-900">Order Placed Successfully!</h2>
          <p class="text-xs text-emerald-700">Thank you for ordering with Flipkart. An order confirmation has been created.</p>
        </div>
      </div>
    <% } %>

    <!-- Header bar -->
    <div class="bg-white p-4 rounded-sm shadow-sm border border-gray-200 flex flex-wrap items-center justify-between gap-3 text-xs">
      <div>
        <h1 class="text-base font-bold text-gray-900">Order #<%= order.orderNumber %></h1>
        <span class="text-gray-500">Placed on <%= formatDate(order.createdAt) %></span>
      </div>

      <div class="flex items-center gap-3">
        <% if (['Placed', 'Confirmed'].includes(order.orderStatus)) { %>
          <form action="/orders/<%= order._id %>/cancel" method="POST" onsubmit="return confirm('Are you sure you want to cancel this order?')">
            <button type="submit" class="bg-red-50 text-red-700 hover:bg-red-100 font-bold px-4 py-2 rounded text-xs border border-red-200">
              Cancel Order
            </button>
          </form>
        <% } %>
        <button onclick="window.print()" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold px-4 py-2 rounded text-xs flex items-center gap-1.5">
          <i class="fa-solid fa-print"></i> Print Invoice
        </button>
      </div>
    </div>

    <!-- Live Status Tracker Timeline -->
    <div class="bg-white p-6 rounded-sm shadow-sm border border-gray-200">
      <h2 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-6">Delivery Progression Timeline</h2>
      
      <% if (order.orderStatus === 'Cancelled') { %>
        <div class="p-4 bg-red-50 border border-red-200 text-red-700 text-xs rounded font-bold flex items-center gap-2">
          <i class="fa-solid fa-circle-xmark text-lg"></i>
          This order was cancelled. Any reservation or charges will be adjusted according to policy.
        </div>
      <% } else { %>
        
        <!-- Interactive Step Timeline Bar -->
        <div class="relative flex items-center justify-between max-w-3xl mx-auto mb-6">
          <div class="absolute left-0 top-1/2 -translate-y-1/2 h-1 bg-gray-200 w-full z-0"></div>
          <div class="absolute left-0 top-1/2 -translate-y-1/2 h-1 bg-emerald-500 z-0 transition-all duration-500" 
               style="width: <%= currentStepIndex >= 0 ? Math.min(100, (currentStepIndex / (steps.length - 1)) * 100) : 0 %>%;"></div>

          <% steps.forEach((step, idx) => { %>
            <div class="relative z-10 flex flex-col items-center">
              <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold transition shadow <%= idx <= currentStepIndex ? 'bg-emerald-600 text-white ring-4 ring-emerald-100' : 'bg-gray-200 text-gray-500' %>">
                <% if (idx < currentStepIndex) { %>
                  <i class="fa-solid fa-check text-[10px]"></i>
                <% } else { %>
                  <%= idx + 1 %>
                <% } %>
              </div>
              <span class="text-[11px] font-semibold mt-2 text-center <%= idx <= currentStepIndex ? 'text-emerald-700 font-bold' : 'text-gray-400' %>">
                <%= step %>
              </span>
            </div>
          <% }) %>
        </div>

      <% } %>

      <!-- Timeline Event Logs -->
      <div class="border-t pt-4 mt-6">
        <h3 class="text-xs font-bold text-gray-700 mb-3">Status Updates:</h3>
        <div class="space-y-2 text-xs divide-y divide-gray-100">
          <% order.statusTimeline.slice().reverse().forEach(evt => { %>
            <div class="pt-2 flex items-start justify-between">
              <div>
                <span class="font-bold text-gray-800"><%= evt.status %></span>: 
                <span class="text-gray-600"><%= evt.message %></span>
              </div>
              <span class="text-gray-400 text-[11px] flex-shrink-0 ml-4"><%= formatDate(evt.timestamp) %></span>
            </div>
          <% }) %>
        </div>
      </div>

    </div>

    <!-- Order Items & Shipping Address Snapshot -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- Items (8 cols) -->
      <div class="lg:col-span-8 bg-white p-5 rounded-sm shadow-sm border border-gray-200">
        <h2 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Items in this Package</h2>
        <div class="divide-y divide-gray-100">
          <% order.items.forEach(item => { %>
            <div class="py-3 flex items-center gap-4">
              <div class="w-16 h-16 border rounded p-1 flex-shrink-0 flex items-center justify-center">
                <img src="<%= item.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=200' %>" class="max-h-full max-w-full object-contain">
              </div>
              <div class="flex-grow text-xs space-y-1">
                <div class="font-bold text-gray-900"><%= item.name %></div>
                <div class="text-gray-500">Price: <%= formatPrice(item.discountPrice || item.price) %> x <%= item.quantity %></div>
              </div>
              <div class="text-sm font-bold text-gray-900">
                <%= formatPrice(item.subtotal) %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Shipping Address & Price Summary (4 cols) -->
      <div class="lg:col-span-4 space-y-4">
        
        <!-- Address Snapshot -->
        <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200 text-xs">
          <h2 class="font-bold text-gray-400 uppercase tracking-wider mb-3 text-[11px]">Delivery Address Snapshot</h2>
          <div class="font-bold text-gray-900 mb-1"><%= order.addressSnapshot.fullName %></div>
          <p class="text-gray-600 leading-relaxed">
            <%= order.addressSnapshot.line1 %>, <%= order.addressSnapshot.line2 ? order.addressSnapshot.line2 + ', ' : '' %><br>
            <%= order.addressSnapshot.city %>, <%= order.addressSnapshot.state %> - <strong><%= order.addressSnapshot.pincode %></strong>
          </p>
          <div class="mt-2 text-gray-700"><strong>Phone:</strong> <%= order.addressSnapshot.phone %></div>
          
          <!-- Assigned Delivery Agent -->
          <% if (order.deliveryAgentId) { %>
            <div class="mt-4 pt-3 border-t border-gray-100 text-emerald-800 bg-emerald-50 p-2 rounded">
              <div class="font-bold flex items-center gap-1.5"><i class="fa-solid fa-truck-fast"></i> Assigned Delivery Partner:</div>
              <div><%= order.deliveryAgentId.name %></div>
              <div class="text-[11px] text-gray-600">Contact: <%= order.deliveryAgentId.phone || 'Available via logistics' %></div>
            </div>
          <% } %>
        </div>

        <!-- Total Breakdown -->
        <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200 text-xs space-y-2">
          <h2 class="font-bold text-gray-400 uppercase tracking-wider mb-3 text-[11px]">Payment Summary</h2>
          <div class="flex justify-between text-gray-600">
            <span>List Price Subtotal:</span>
            <span><%= formatPrice(order.totals.subtotal) %></span>
          </div>
          <div class="flex justify-between text-emerald-600">
            <span>Savings Discount:</span>
            <span>- <%= formatPrice(order.totals.discount) %></span>
          </div>
          <div class="flex justify-between text-gray-600">
            <span>Shipping:</span>
            <span><%= order.totals.shipping === 0 ? 'FREE' : formatPrice(order.totals.shipping) %></span>
          </div>
          <div class="border-t pt-2 flex justify-between font-black text-sm text-gray-900">
            <span>Total Paid / Due:</span>
            <span><%= formatPrice(order.totals.grandTotal) %></span>
          </div>
          <div class="pt-2 text-[11px] text-gray-500">
            Payment Mode: <strong class="uppercase text-gray-800"><%= order.paymentMethod %></strong> 
            (<%= order.paymentStatus %>)
          </div>
        </div>

      </div>

    </div>

  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
