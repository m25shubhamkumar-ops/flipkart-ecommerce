<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow py-6">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    
    <% if (isNewlyPlaced) { %>
      <div class="bg-emerald-50 border-l-4 border-emerald-500 p-4 rounded-r shadow-sm flex items-center gap-3">
        <i class="fa-solid fa-circle-check text-emerald-600 text-2xl"></i>
        <div>
          <h2 class="text-sm font-bold text-emerald-900">Order Placed Successfully!</h2>
          <p class="text-xs text-emerald-700">Thank you for ordering with Flipkart. An order confirmation has been created.</p>
        </div>
      </div>
    <% } %>

    <% if (success) { %>
      <div class="bg-emerald-50 border-l-4 border-emerald-500 p-4 rounded-r shadow-sm flex items-center gap-3">
        <i class="fa-solid fa-circle-check text-emerald-600 text-xl"></i>
        <p class="text-xs font-bold text-emerald-900"><%= success %></p>
      </div>
    <% } %>

    <% if (error) { %>
      <div class="bg-rose-50 border-l-4 border-rose-500 p-4 rounded-r shadow-sm flex items-center gap-3">
        <i class="fa-solid fa-triangle-exclamation text-rose-600 text-xl"></i>
        <p class="text-xs font-bold text-rose-900"><%= error %></p>
      </div>
    <% } %>

    <!-- Header bar -->
    <div class="bg-white p-4 rounded-sm shadow-sm border border-gray-200 flex flex-wrap items-center justify-between gap-3 text-xs">
      <div>
        <h1 class="text-base font-bold text-gray-900">Order #<%= order.orderNumber %></h1>
        <span class="text-gray-500">Placed on <%= formatDate(order.createdAt) %></span>
      </div>

      <div class="flex items-center gap-3">
        <!-- Cancel button for pre-dispatch orders -->
        <% if (['Placed', 'Confirmed', 'Packed'].includes(order.orderStatus)) { %>
          <button type="button" onclick="openCancelModal()" class="bg-red-50 text-red-700 hover:bg-red-100 font-bold px-4 py-2 rounded text-xs border border-red-200 flex items-center gap-1.5 transition">
            <i class="fa-solid fa-ban"></i> Cancel Order
          </button>
        <% } %>

        <!-- Return / Replace button for delivered orders within 7 days -->
        <% if (order.orderStatus === 'Delivered') { %>
          <% if (isReturnEligible) { %>
            <button type="button" onclick="openReturnModal()" class="bg-amber-50 text-amber-800 hover:bg-amber-100 font-bold px-4 py-2 rounded text-xs border border-amber-300 flex items-center gap-1.5 transition">
              <i class="fa-solid fa-rotate-left"></i> Return / Replace Item
            </button>
          <% } else { %>
            <span class="text-[11px] text-gray-500 bg-gray-100 px-3 py-1.5 rounded flex items-center gap-1.5" title="Return window is 7 days from delivery date">
              <i class="fa-solid fa-clock-rotate-left"></i> 7-Day Return Policy Expired
            </span>
          <% } %>
        <% } %>

        <button onclick="window.print()" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold px-4 py-2 rounded text-xs flex items-center gap-1.5">
          <i class="fa-solid fa-print"></i> Print Invoice
        </button>
      </div>
    </div>

    <!-- Live Status Tracker Timeline -->
    <div class="bg-white p-6 rounded-sm shadow-sm border border-gray-200">
      
      <% if (order.orderStatus === 'Cancelled') { %>
        <!-- Cancelled State & Refund Details -->
        <div class="p-5 bg-red-50 border border-red-200 rounded-sm">
          <div class="flex items-start gap-3">
            <i class="fa-solid fa-circle-xmark text-red-600 text-2xl mt-0.5"></i>
            <div class="space-y-2 flex-grow">
              <h3 class="text-sm font-bold text-red-900">This order has been cancelled</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 text-xs pt-1">
                <div>
                  <span class="text-gray-500">Reason:</span>
                  <p class="font-semibold text-gray-800"><%= order.cancellationDetails?.reason || 'Customer request' %></p>
                </div>
                <div>
                  <span class="text-gray-500">Cancelled By:</span>
                  <p class="font-semibold text-gray-800"><%= order.cancellationDetails?.cancelledBy || 'Customer' %></p>
                </div>
                <div>
                  <span class="text-gray-500">Date:</span>
                  <p class="font-semibold text-gray-800"><%= formatDate(order.cancellationDetails?.cancelledAt || order.updatedAt) %></p>
                </div>
                <% if (order.cancellationDetails?.comments) { %>
                  <div>
                    <span class="text-gray-500">Comments:</span>
                    <p class="font-semibold text-gray-800"><%= order.cancellationDetails.comments %></p>
                  </div>
                <% } %>
              </div>

              <!-- Refund Status Box for Cancelled Prepaid Orders -->
              <% if (order.refundDetails && order.refundDetails.refundStatus) { %>
                <div class="mt-3 pt-3 border-t border-red-200 flex flex-wrap items-center justify-between gap-3 text-xs bg-white p-3 rounded border">
                  <div>
                    <span class="text-emerald-700 font-bold flex items-center gap-1.5">
                      <i class="fa-solid fa-circle-check"></i> Refund <%= order.refundDetails.refundStatus.toUpperCase() %>
                    </span>
                    <span class="text-gray-600">Amount: <strong><%= formatPrice(order.refundDetails.amount) %></strong></span>
                    <% if (order.refundDetails.transactionId) { %>
                      <span class="text-gray-500 text-[11px] ml-2">(Ref: <%= order.refundDetails.transactionId %>)</span>
                    <% } %>
                  </div>
                  <div class="text-[11px] text-gray-500">
                    Mode: <%= order.refundDetails.refundMethod || order.paymentMethod %>
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        </div>

      <% } else if (['Return Requested', 'Return Approved', 'Return Picked Up', 'Returned & Refunded', 'Return Rejected'].includes(order.orderStatus)) { %>
        
        <!-- Return & Refund Lifecycle Tracker -->
        <h2 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Return & Refund Tracker</h2>
        
        <% if (order.orderStatus === 'Return Rejected') { %>
          <div class="p-4 bg-red-50 border border-red-200 text-red-800 rounded text-xs flex items-center gap-3 mb-6">
            <i class="fa-solid fa-circle-exclamation text-red-600 text-xl"></i>
            <div>
              <p class="font-bold">Return Request Declined</p>
              <p class="text-gray-600">Your return request was reviewed and could not be accepted. Please contact customer support for further assistance.</p>
            </div>
          </div>
        <% } else { %>
          <!-- Return Stepper -->
          <% 
            const returnSteps = ['Return Requested', 'Return Approved', 'Return Picked Up', 'Returned & Refunded'];
            const retIdx = returnSteps.indexOf(order.orderStatus);
          %>
          <div class="relative flex items-center justify-between max-w-2xl mx-auto mb-6">
            <div class="absolute left-0 top-1/2 -translate-y-1/2 h-1 bg-gray-200 w-full z-0"></div>
            <div class="absolute left-0 top-1/2 -translate-y-1/2 h-1 bg-amber-500 z-0 transition-all duration-500"
                 style="width: <%= retIdx >= 0 ? Math.min(100, (retIdx / (returnSteps.length - 1)) * 100) : 0 %>%;"></div>

            <% returnSteps.forEach((st, idx) => { %>
              <div class="relative z-10 flex flex-col items-center">
                <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold transition shadow <%= idx <= retIdx ? 'bg-amber-600 text-white ring-4 ring-amber-100' : 'bg-gray-200 text-gray-500' %>">
                  <% if (idx < retIdx) { %>
                    <i class="fa-solid fa-check text-[10px]"></i>
                  <% } else { %>
                    <%= idx + 1 %>
                  <% } %>
                </div>
                <span class="text-[11px] font-semibold mt-2 text-center <%= idx <= retIdx ? 'text-amber-800 font-bold' : 'text-gray-400' %>">
                  <%= st %>
                </span>
              </div>
            <% }) %>
          </div>
        <% } %>

        <!-- Return Request Snapshot -->
        <div class="bg-amber-50/50 border border-amber-200 rounded p-4 text-xs space-y-2 mb-4">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-amber-100 pb-2">
            <span class="font-bold text-amber-900 flex items-center gap-1.5">
              <i class="fa-solid fa-arrows-rotate text-amber-600"></i> Return Request Details
            </span>
            <span class="text-gray-500">Requested on <%= formatDate(order.returnDetails?.requestedAt || order.updatedAt) %></span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1 text-gray-700">
            <div>
              <span class="text-gray-500 block text-[11px]">Resolution Type</span>
              <span class="font-bold capitalize <%= order.returnDetails?.resolution === 'replacement' ? 'text-blue-700' : 'text-emerald-700' %>">
                <%= order.returnDetails?.resolution === 'replacement' ? 'Replacement with New Item' : 'Refund to Account' %>
              </span>
            </div>
            <div>
              <span class="text-gray-500 block text-[11px]">Reason</span>
              <span class="font-semibold text-gray-900"><%= order.returnDetails?.reason || 'Not specified' %></span>
            </div>
            <div>
              <span class="text-gray-500 block text-[11px]">Current Return Status</span>
              <span class="font-bold text-amber-700"><%= order.orderStatus %></span>
            </div>
          </div>

          <% if (order.returnDetails?.comments) { %>
            <div class="text-[11px] text-gray-600 pt-1">
              <strong>Customer Note:</strong> "<%= order.returnDetails.comments %>"
            </div>
          <% } %>

          <!-- Refund Info if applicable -->
          <% if (order.refundDetails && order.returnDetails?.resolution !== 'replacement') { %>
            <div class="mt-2 pt-2 border-t border-amber-200 flex flex-wrap items-center justify-between gap-3 bg-white p-2.5 rounded border border-amber-100">
              <div>
                <span class="text-xs font-bold <%= order.refundDetails.refundStatus === 'completed' ? 'text-emerald-700' : 'text-amber-700' %>">
                  <i class="fa-solid <%= order.refundDetails.refundStatus === 'completed' ? 'fa-circle-check' : 'fa-hourglass-half' %>"></i>
                  Refund <%= order.refundDetails.refundStatus === 'completed' ? 'Completed' : 'Initiated' %>: <%= formatPrice(order.refundDetails.amount) %>
                </span>
                <% if (order.refundDetails.transactionId) { %>
                  <span class="text-[11px] text-gray-500 ml-2">TXN: <%= order.refundDetails.transactionId %></span>
                <% } %>
              </div>
              <div class="text-[11px] text-gray-600">
                Payout: <strong><%= order.refundDetails.refundMethod || 'Original Method' %></strong>
                <% if (order.refundDetails.payoutDetails?.upiId) { %>
                  (UPI: <%= order.refundDetails.payoutDetails.upiId %>)
                <% } else if (order.refundDetails.payoutDetails?.bankAccount) { %>
                  (A/C: ****<%= order.refundDetails.payoutDetails.bankAccount.slice(-4) %>)
                <% } %>
              </div>
            </div>
          <% } %>
        </div>

      <% } else { %>
        
        <!-- Interactive Step Timeline Bar -->
        <h2 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-6">Delivery Progression Timeline</h2>
        <div class="relative flex items-center justify-between max-w-3xl mx-auto mb-6">
          <div class="absolute left-0 top-1/2 -translate-y-1/2 h-1 bg-gray-200 w-full z-0"></div>
          <div class="absolute left-0 top-1/2 -translate-y-1/2 h-1 bg-emerald-500 z-0 transition-all duration-500" 
               style="width: <%= currentStepIndex >= 0 ? Math.min(100, (currentStepIndex / (steps.length - 1)) * 100) : 0 %>%;"></div>

          <% steps.forEach((step, idx) => { %>
            <div class="relative z-10 flex flex-col items-center">
              <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold transition shadow <%= idx <= currentStepIndex ? 'bg-emerald-600 text-white ring-4 ring-emerald-100' : 'bg-gray-200 text-gray-500' %>">
                <% if (idx < currentStepIndex) { %>
                  <i class="fa-solid fa-check text-[10px]"></i>
                <% } else { %>
                  <%= idx + 1 %>
                <% } %>
              </div>
              <span class="text-[11px] font-semibold mt-2 text-center <%= idx <= currentStepIndex ? 'text-emerald-700 font-bold' : 'text-gray-400' %>">
                <%= step %>
              </span>
            </div>
          <% }) %>
        </div>

        <% if (order.orderStatus === 'Delivered') { %>
          <div class="mt-4 p-3 bg-emerald-50 border border-emerald-200 rounded text-xs flex items-center justify-between text-emerald-900">
            <span class="flex items-center gap-2">
              <i class="fa-solid fa-shield-check text-emerald-600 text-base"></i>
              <strong>Flipkart Assured:</strong> 7-Day Hassle-Free Returns & Replacements Available
            </span>
            <% if (isReturnEligible) { %>
              <button onclick="openReturnModal()" class="text-blue-600 font-bold hover:underline">
                Request Return &rarr;
              </button>
            <% } %>
          </div>
        <% } %>

      <% } %>

      <!-- Timeline Event Logs -->
      <div class="border-t pt-4 mt-6">
        <h3 class="text-xs font-bold text-gray-700 mb-3">Status Updates:</h3>
        <div class="space-y-2 text-xs divide-y divide-gray-100">
          <% order.statusTimeline.slice().reverse().forEach(evt => { %>
            <div class="pt-2 flex items-start justify-between">
              <div>
                <span class="font-bold text-gray-800"><%= evt.status %></span>: 
                <span class="text-gray-600"><%= evt.message %></span>
              </div>
              <span class="text-gray-400 text-[11px] flex-shrink-0 ml-4"><%= formatDate(evt.timestamp) %></span>
            </div>
          <% }) %>
        </div>
      </div>

    </div>

    <!-- Order Items & Shipping Address Snapshot -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- Items (8 cols) -->
      <div class="lg:col-span-8 bg-white p-5 rounded-sm shadow-sm border border-gray-200">
        <h2 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">Items in this Package</h2>
        <div class="divide-y divide-gray-100">
          <% order.items.forEach(item => { %>
            <div class="py-3 flex items-center gap-4">
              <div class="w-16 h-16 border rounded p-1 flex-shrink-0 flex items-center justify-center">
                <img src="<%= item.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=200' %>" class="max-h-full max-w-full object-contain">
              </div>
              <div class="flex-grow text-xs space-y-1">
                <div class="font-bold text-gray-900"><%= item.name %></div>
                <div class="text-gray-500">Price: <%= formatPrice(item.discountPrice || item.price) %> x <%= item.quantity %></div>
              </div>
              <div class="text-sm font-bold text-gray-900">
                <%= formatPrice(item.subtotal) %>
              </div>
            </div>
          <% }) %>
        </div>
      </div>

      <!-- Shipping Address & Price Summary (4 cols) -->
      <div class="lg:col-span-4 space-y-4">
        
        <!-- Address Snapshot -->
        <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200 text-xs">
          <h2 class="font-bold text-gray-400 uppercase tracking-wider mb-3 text-[11px]">Delivery Address Snapshot</h2>
          <div class="font-bold text-gray-900 mb-1"><%= order.addressSnapshot.fullName %></div>
          <p class="text-gray-600 leading-relaxed">
            <%= order.addressSnapshot.line1 %>, <%= order.addressSnapshot.line2 ? order.addressSnapshot.line2 + ', ' : '' %><br>
            <%= order.addressSnapshot.city %>, <%= order.addressSnapshot.state %> - <strong><%= order.addressSnapshot.pincode %></strong>
          </p>
          <div class="mt-2 text-gray-700"><strong>Phone:</strong> <%= order.addressSnapshot.phone %></div>
          
          <!-- Assigned Delivery Agent -->
          <% if (order.deliveryAgentId) { %>
            <div class="mt-4 pt-3 border-t border-gray-100 text-emerald-800 bg-emerald-50 p-2 rounded">
              <div class="font-bold flex items-center gap-1.5"><i class="fa-solid fa-truck-fast"></i> Assigned Delivery Partner:</div>
              <div><%= order.deliveryAgentId.name %></div>
              <div class="text-[11px] text-gray-600">Contact: <%= order.deliveryAgentId.phone || 'Available via logistics' %></div>
            </div>
          <% } %>
        </div>

        <!-- Total Breakdown -->
        <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200 text-xs space-y-2">
          <h2 class="font-bold text-gray-400 uppercase tracking-wider mb-3 text-[11px]">Payment Summary</h2>
          <div class="flex justify-between text-gray-600">
            <span>List Price Subtotal:</span>
            <span><%= formatPrice(order.totals.subtotal) %></span>
          </div>
          <div class="flex justify-between text-emerald-600">
            <span>Savings Discount:</span>
            <span>- <%= formatPrice(order.totals.discount) %></span>
          </div>
          <div class="flex justify-between text-gray-600">
            <span>Shipping:</span>
            <span><%= order.totals.shipping === 0 ? 'FREE' : formatPrice(order.totals.shipping) %></span>
          </div>
          <div class="border-t pt-2 flex justify-between font-black text-sm text-gray-900">
            <span>Total Paid / Due:</span>
            <span><%= formatPrice(order.totals.grandTotal) %></span>
          </div>
          <div class="pt-2 text-[11px] text-gray-500">
            Payment Mode: <strong class="uppercase text-gray-800"><%= order.paymentMethod %></strong> 
            (<%= order.paymentStatus %>)
          </div>
        </div>

      </div>

    </div>

  </div>
</main>

<!-- Cancel Order Modal -->
<div id="cancelModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-lg max-w-md w-full p-6 shadow-xl space-y-4">
    <div class="flex items-center justify-between border-b pb-3">
      <h3 class="text-sm font-bold text-gray-900 flex items-center gap-2">
        <i class="fa-solid fa-circle-exclamation text-red-500"></i> Cancel Order
      </h3>
      <button type="button" onclick="closeCancelModal()" class="text-gray-400 hover:text-gray-600">
        <i class="fa-solid fa-xmark text-base"></i>
      </button>
    </div>

    <form action="/orders/<%= order._id %>/cancel" method="POST" class="space-y-4 text-xs">
      <div>
        <label class="block font-bold text-gray-700 mb-1">Reason for Cancellation <span class="text-red-500">*</span></label>
        <select name="reason" required class="w-full border border-gray-300 rounded p-2 focus:ring-1 focus:ring-blue-500 text-xs">
          <option value="">-- Select a reason --</option>
          <option value="Incorrect item ordered">Incorrect item ordered</option>
          <option value="Found a better price elsewhere">Found a better price elsewhere</option>
          <option value="Delivery time is too long">Delivery time is too long</option>
          <option value="Changed my mind">Changed my mind</option>
          <option value="Order placed by mistake">Order placed by mistake</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <div>
        <label class="block font-bold text-gray-700 mb-1">Additional Comments (Optional)</label>
        <textarea name="comments" rows="3" placeholder="Tell us more about why you are cancelling..." class="w-full border border-gray-300 rounded p-2 focus:ring-1 focus:ring-blue-500 text-xs"></textarea>
      </div>

      <div class="p-3 bg-amber-50 border border-amber-200 rounded text-[11px] text-amber-800">
        <i class="fa-solid fa-info-circle"></i> Once cancelled, the items will be returned to inventory. If you paid online, your refund will be processed back to your original payment method automatically.
      </div>

      <div class="flex justify-end gap-3 pt-2">
        <button type="button" onclick="closeCancelModal()" class="px-4 py-2 rounded bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold">
          Keep Order
        </button>
        <button type="submit" class="px-4 py-2 rounded bg-red-600 hover:bg-red-700 text-white font-bold">
          Confirm Cancellation
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Return / Replacement Modal -->
<div id="returnModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-lg max-w-lg w-full p-6 shadow-xl space-y-4 max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between border-b pb-3">
      <h3 class="text-sm font-bold text-gray-900 flex items-center gap-2">
        <i class="fa-solid fa-rotate-left text-amber-600"></i> Return or Replace Item
      </h3>
      <button type="button" onclick="closeReturnModal()" class="text-gray-400 hover:text-gray-600">
        <i class="fa-solid fa-xmark text-base"></i>
      </button>
    </div>

    <form action="/orders/<%= order._id %>/return" method="POST" class="space-y-4 text-xs">
      
      <!-- Resolution Preference -->
      <div>
        <label class="block font-bold text-gray-700 mb-2">Choose Resolution Option <span class="text-red-500">*</span></label>
        <div class="grid grid-cols-2 gap-3">
          <label class="flex items-center gap-2 p-3 border rounded cursor-pointer hover:bg-gray-50 border-blue-500 bg-blue-50/30">
            <input type="radio" name="resolution" value="refund" checked class="text-blue-600 focus:ring-blue-500" onchange="toggleCodPayout()">
            <div>
              <div class="font-bold text-gray-900">Refund Money</div>
              <div class="text-[10px] text-gray-500">Credited to original mode or bank</div>
            </div>
          </label>
          <label class="flex items-center gap-2 p-3 border rounded cursor-pointer hover:bg-gray-50">
            <input type="radio" name="resolution" value="replacement" class="text-blue-600 focus:ring-blue-500" onchange="toggleCodPayout()">
            <div>
              <div class="font-bold text-gray-900">Replacement</div>
              <div class="text-[10px] text-gray-500">Send brand new replacement</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Return Reason -->
      <div>
        <label class="block font-bold text-gray-700 mb-1">Reason for Return <span class="text-red-500">*</span></label>
        <select name="reason" required class="w-full border border-gray-300 rounded p-2 focus:ring-1 focus:ring-blue-500 text-xs">
          <option value="">-- Select a reason --</option>
          <option value="Defective or damaged product">Defective or damaged product</option>
          <option value="Item looks different from description">Item looks different from description</option>
          <option value="Size or fit issue">Size or fit issue</option>
          <option value="Missing parts or accessories">Missing parts or accessories</option>
          <option value="Quality not as expected">Quality not as expected</option>
          <option value="Wrong item received">Wrong item received</option>
          <option value="Other">Other</option>
        </select>
      </div>

      <!-- Comments -->
      <div>
        <label class="block font-bold text-gray-700 mb-1">Detailed Description of Issue</label>
        <textarea name="comments" rows="3" placeholder="Please describe the defect, damage, or reason in detail..." class="w-full border border-gray-300 rounded p-2 focus:ring-1 focus:ring-blue-500 text-xs"></textarea>
      </div>

      <!-- COD Bank / UPI Payout Details (Only if payment was COD) -->
      <% if (order.paymentMethod === 'COD') { %>
        <div id="codPayoutBox" class="p-3 bg-blue-50 border border-blue-200 rounded space-y-2">
          <label class="block font-bold text-blue-900">COD Refund Payout Details</label>
          <p class="text-[11px] text-blue-700">Since this order was Cash on Delivery, please provide your UPI ID or Bank Account for refund remittance upon return inspection:</p>
          <div>
            <label class="block text-[11px] font-semibold text-gray-700">UPI ID (Fastest)</label>
            <input type="text" name="upiId" placeholder="e.g. yourname@oksbi" class="w-full border border-gray-300 rounded p-1.5 text-xs">
          </div>
          <div class="text-center text-[10px] text-gray-400 font-bold">OR</div>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="block text-[11px] font-semibold text-gray-700">Bank Account Number</label>
              <input type="text" name="bankAccount" placeholder="Account Number" class="w-full border border-gray-300 rounded p-1.5 text-xs">
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-gray-700">IFSC Code</label>
              <input type="text" name="ifsc" placeholder="e.g. SBIN0001234" class="w-full border border-gray-300 rounded p-1.5 text-xs">
            </div>
          </div>
        </div>
      <% } %>

      <div class="p-3 bg-emerald-50 border border-emerald-200 rounded text-[11px] text-emerald-800">
        <i class="fa-solid fa-box"></i> <strong>Return Policy:</strong> Please ensure the product is unused, in original packaging with brand tags and invoice intact for the pickup executive.
      </div>

      <div class="flex justify-end gap-3 pt-2">
        <button type="button" onclick="closeReturnModal()" class="px-4 py-2 rounded bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold">
          Close
        </button>
        <button type="submit" class="px-4 py-2 rounded bg-amber-600 hover:bg-amber-700 text-white font-bold">
          Submit Return Request
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openCancelModal() {
    const el = document.getElementById('cancelModal');
    if (el) el.classList.remove('hidden');
  }
  function closeCancelModal() {
    const el = document.getElementById('cancelModal');
    if (el) el.classList.add('hidden');
  }
  function openReturnModal() {
    const el = document.getElementById('returnModal');
    if (el) el.classList.remove('hidden');
  }
  function closeReturnModal() {
    const el = document.getElementById('returnModal');
    if (el) el.classList.add('hidden');
  }
  function toggleCodPayout() {
    const box = document.getElementById('codPayoutBox');
    if (!box) return;
    const isRefund = document.querySelector('input[name="resolution"][value="refund"]')?.checked;
    box.style.display = isRefund ? 'block' : 'none';
  }
</script>

<%- include('../partials/footer') %>
</body>
</html>
