<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow flex items-center justify-center py-12 px-4">
  <div class="max-w-md w-full bg-white rounded shadow-md p-8">
    <div class="text-center mb-6">
      <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-2 text-xl">
        <i class="fa-solid fa-lock-open"></i>
      </div>
      <h2 class="text-lg font-bold text-gray-900">Set New Password</h2>
      <p class="text-xs text-gray-500 mt-1">Verification for <strong><%= email %></strong></p>
    </div>

    <%- include('../partials/alerts') %>

    <form action="/reset-password" method="POST" class="space-y-4 text-xs">
      <input type="hidden" name="email" value="<%= email %>">

      <div>
        <label class="block font-semibold text-gray-700 mb-1">6-Digit Reset OTP *</label>
        <input type="text" name="otp" maxlength="6" required placeholder="Enter OTP code" class="w-full p-2.5 border rounded text-xs text-center font-bold tracking-widest text-lg">
      </div>

      <div>
        <label class="block font-semibold text-gray-700 mb-1">New Password *</label>
        <div class="relative">
          <input type="password" id="resetPassword" name="password" required placeholder="At least 6 characters" class="w-full p-2.5 pr-10 border rounded text-xs">
          <button type="button" onclick="togglePasswordVisibility('resetPassword', this)" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-500 hover:text-blue-600 focus:outline-none text-sm p-1" title="Show or hide password" aria-label="Show password">
            <i class="fa-regular fa-eye"></i>
          </button>
        </div>
      </div>

      <div>
        <label class="block font-semibold text-gray-700 mb-1">Confirm New Password *</label>
        <div class="relative">
          <input type="password" id="resetConfirmPassword" name="confirmPassword" required placeholder="Repeat new password" class="w-full p-2.5 pr-10 border rounded text-xs">
          <button type="button" onclick="togglePasswordVisibility('resetConfirmPassword', this)" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-500 hover:text-blue-600 focus:outline-none text-sm p-1" title="Show or hide password" aria-label="Show password">
            <i class="fa-regular fa-eye"></i>
          </button>
        </div>
      </div>


      <button type="submit" class="w-full bg-[#fb641b] hover:bg-[#ea550d] text-white font-bold py-2.5 rounded text-xs uppercase tracking-wider shadow">
        Reset Password
      </button>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
