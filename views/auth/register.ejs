<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow flex items-center justify-center py-10 px-4">
  <div class="max-w-3xl w-full bg-white rounded-2xl shadow-xl border border-slate-200/80 overflow-hidden grid grid-cols-1 md:grid-cols-12 min-h-[500px]">
    
    <!-- Left Blue Info Panel -->
    <div class="md:col-span-5 bg-gradient-to-br from-slate-950 via-indigo-950 to-blue-900 p-8 text-white flex flex-col justify-between relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>

      <div class="relative">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-400 to-amber-500 text-slate-950 flex items-center justify-center text-lg font-black shadow-md mb-4">
          <i class="fa-solid fa-shop"></i>
        </div>
        <h2 class="text-2xl font-black">Join My Local Shop!</h2>
        <p class="text-indigo-200 text-xs sm:text-sm mt-3 leading-relaxed">
          Sign up with your email and mobile number to access fast neighborhood deliveries, verified local stores, and exclusive daily deals.
        </p>
      </div>
      <div class="hidden md:block mt-8 text-center text-xs text-amber-300 font-semibold bg-white/10 backdrop-blur-sm py-2 px-3 rounded-lg border border-white/10">
        <i class="fa-solid fa-truck-fast mr-1"></i> Fast Neighborhood Deliveries
      </div>
    </div>

    <!-- Right Registration Form -->
    <div class="md:col-span-7 p-8 flex flex-col justify-between">
      <div>
        <!-- Auth Tabs -->
        <div class="flex border-b border-slate-200 mb-5 text-sm font-semibold">
          <a href="/login<%= typeof redirect !== 'undefined' && redirect ? '?redirect=' + encodeURIComponent(redirect) : '' %>" 
             class="pb-2.5 px-4 border-b-2 border-transparent text-slate-400 hover:text-slate-700 transition font-medium">
            Sign In
          </a>
          <a href="/register<%= (typeof formData !== 'undefined' && formData.email) ? '?email=' + encodeURIComponent(formData.email) : '' %><%= typeof redirect !== 'undefined' && redirect ? ((typeof formData !== 'undefined' && formData.email ? '&' : '?') + 'redirect=' + encodeURIComponent(redirect)) : '' %>" 
             class="pb-2.5 px-4 border-b-2 border-indigo-600 text-indigo-600 font-bold">
            Register
          </a>
        </div>

        <h3 class="text-lg font-black text-slate-800 mb-4">Create Your Account</h3>
        <%- include('../partials/alerts') %>

        <form action="/register" method="POST" class="space-y-4 text-xs">
          <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '' %>">
          <div>
            <label class="block text-slate-600 font-semibold mb-1">Full Name *</label>
            <input type="text" name="name" value="<%= formData.name || '' %>" required placeholder="Enter your full name" class="w-full p-2.5 border border-slate-300 rounded-lg focus:border-indigo-500 focus:ring-1 focus:ring-indigo-400 focus:outline-none text-xs">
          </div>

          <div>
            <label class="block text-slate-600 font-semibold mb-1">Email Address *</label>
            <input type="email" name="email" value="<%= formData.email || '' %>" required placeholder="name@example.com" class="w-full p-2.5 border border-slate-300 rounded-lg focus:border-indigo-500 focus:ring-1 focus:ring-indigo-400 focus:outline-none text-xs">
          </div>

          <!-- Mobile Number is MANDATORY -->
          <div>
            <label class="block text-slate-600 font-semibold mb-1">10-Digit Mobile Number *</label>
            <input 
              type="tel" 
              name="phone" 
              value="<%= formData.phone || '' %>" 
              required 
              pattern="[0-9]{10}" 
              maxlength="10" 
              placeholder="e.g. 9876543210 (10 digits required)" 
              class="w-full p-2.5 border border-slate-300 rounded-lg focus:border-indigo-500 focus:ring-1 focus:ring-indigo-400 focus:outline-none text-xs"
            >
            <span class="text-[10px] text-slate-500 mt-1 block">Required for order tracking and delivery confirmation.</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-slate-600 font-semibold mb-1">Password *</label>
              <div class="relative">
                <input type="password" id="regPassword" name="password" required minlength="6" placeholder="Min 6 characters" class="w-full p-2.5 pr-9 border border-slate-300 rounded-lg focus:border-indigo-500 focus:ring-1 focus:ring-indigo-400 focus:outline-none text-xs">
                <button type="button" onclick="togglePasswordVisibility('regPassword', this)" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-indigo-600 focus:outline-none text-xs p-1" title="Show or hide password" aria-label="Show password">
                  <i class="fa-regular fa-eye"></i>
                </button>
              </div>
            </div>
            <div>
              <label class="block text-slate-600 font-semibold mb-1">Confirm Password *</label>
              <div class="relative">
                <input type="password" id="regConfirmPassword" name="confirmPassword" required minlength="6" placeholder="Repeat password" class="w-full p-2.5 pr-9 border border-slate-300 rounded-lg focus:border-indigo-500 focus:ring-1 focus:ring-indigo-400 focus:outline-none text-xs">
                <button type="button" onclick="togglePasswordVisibility('regConfirmPassword', this)" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-indigo-600 focus:outline-none text-xs p-1" title="Show or hide password" aria-label="Show password">
                  <i class="fa-regular fa-eye"></i>
                </button>
              </div>
            </div>
          </div>

          <p class="text-[11px] text-slate-500 leading-normal">
            By continuing, you agree to My Local Shop's Terms of Use and Privacy Policy.
          </p>

          <button type="submit" class="btn-3d-amber w-full py-3 text-xs uppercase tracking-wider mt-2">
            Continue & Send OTP
          </button>
        </form>
      </div>

      <div class="mt-6 pt-4 border-t border-slate-100 text-center">
        <a href="/login" class="text-indigo-600 font-bold text-xs hover:underline">
          Existing User? Log in
        </a>
      </div>

    </div>

  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
