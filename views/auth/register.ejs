<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow flex items-center justify-center py-10 px-4">
  <div class="max-w-3xl w-full bg-white rounded shadow-md overflow-hidden grid grid-cols-1 md:grid-cols-12 min-h-[500px]">
    
    <!-- Left Blue Info Panel -->
    <div class="md:col-span-5 bg-[#2874f0] p-8 text-white flex flex-col justify-between">
      <div>
        <h2 class="text-2xl font-black">Looks like you're new here!</h2>
        <p class="text-blue-100 text-sm mt-3 leading-relaxed">
          Sign up with your email and mobile number to get started with fast shopping, order tracking, and exclusive Big Deals.
        </p>
      </div>
      <div class="hidden md:block mt-8">
        <img src="https://static-assets-web.flixcart.com/fk-p-linchpin-web/fk-cp-zion/img/login_img_c4a81e.png" alt="Shopping illustration" class="max-w-full">
      </div>
    </div>

    <!-- Right Registration Form -->
    <div class="md:col-span-7 p-8 flex flex-col justify-between">
      <div>
        <h3 class="text-lg font-bold text-gray-800 mb-4">Create Your Account</h3>
        <%- include('../partials/alerts') %>

        <form action="/register" method="POST" class="space-y-4 text-xs">
          <div>
            <label class="block text-gray-700 font-bold mb-1">Full Name *</label>
            <input type="text" name="name" value="<%= formData.name || '' %>" required placeholder="Enter your full name" class="w-full p-2.5 border border-gray-300 rounded focus:border-blue-500 focus:outline-none text-xs">
          </div>

          <div>
            <label class="block text-gray-700 font-bold mb-1">Email Address *</label>
            <input type="email" name="email" value="<%= formData.email || '' %>" required placeholder="name@example.com" class="w-full p-2.5 border border-gray-300 rounded focus:border-blue-500 focus:outline-none text-xs">
          </div>

          <!-- Mobile Number is MANDATORY -->
          <div>
            <label class="block text-gray-700 font-bold mb-1">10-Digit Mobile Number *</label>
            <input 
              type="tel" 
              name="phone" 
              value="<%= formData.phone || '' %>" 
              required 
              pattern="[0-9]{10}" 
              maxlength="10" 
              placeholder="e.g. 9876543210 (10 digits required)" 
              class="w-full p-2.5 border border-gray-300 rounded focus:border-blue-500 focus:outline-none text-xs"
            >
            <span class="text-[10px] text-gray-500">Required for order tracking and delivery confirmation.</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="block text-gray-700 font-bold mb-1">Password *</label>
              <div class="relative">
                <input type="password" id="regPassword" name="password" required minlength="6" placeholder="Min 6 characters" class="w-full p-2.5 pr-9 border border-gray-300 rounded focus:border-blue-500 focus:outline-none text-xs">
                <button type="button" onclick="togglePasswordVisibility('regPassword', this)" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-500 hover:text-blue-600 focus:outline-none text-xs p-1" title="Show or hide password" aria-label="Show password">
                  <i class="fa-regular fa-eye"></i>
                </button>
              </div>
            </div>
            <div>
              <label class="block text-gray-700 font-bold mb-1">Confirm Password *</label>
              <div class="relative">
                <input type="password" id="regConfirmPassword" name="confirmPassword" required minlength="6" placeholder="Repeat password" class="w-full p-2.5 pr-9 border border-gray-300 rounded focus:border-blue-500 focus:outline-none text-xs">
                <button type="button" onclick="togglePasswordVisibility('regConfirmPassword', this)" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-500 hover:text-blue-600 focus:outline-none text-xs p-1" title="Show or hide password" aria-label="Show password">
                  <i class="fa-regular fa-eye"></i>
                </button>
              </div>
            </div>
          </div>


          <p class="text-[11px] text-gray-500 leading-normal">
            By continuing, you agree to Flipkart's Terms of Use and Privacy Policy.
          </p>

          <button type="submit" class="w-full bg-[#fb641b] hover:bg-[#ea550d] text-white font-bold py-3 rounded-sm uppercase tracking-wider text-xs shadow transition">
            Continue & Send OTP
          </button>
        </form>
      </div>

      <div class="mt-6 pt-4 border-t text-center">
        <a href="/login" class="text-blue-600 font-bold text-xs hover:underline">
          Existing User? Log in
        </a>
      </div>

    </div>

  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
