<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow flex items-center justify-center py-10 px-4">
  <div class="max-w-3xl w-full bg-white rounded-2xl shadow-xl border border-slate-200/80 overflow-hidden grid grid-cols-1 md:grid-cols-12 min-h-[480px]">
    
    <!-- Left Blue Info Panel -->
    <div class="md:col-span-5 bg-gradient-to-br from-slate-950 via-indigo-950 to-blue-900 p-8 text-white flex flex-col justify-between relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>

      <div class="relative">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-400 to-amber-500 text-slate-950 flex items-center justify-center text-lg font-black shadow-md mb-4">
          <i class="fa-solid fa-shop"></i>
        </div>
        <h2 class="text-2xl font-black">Welcome Back!</h2>
        <p class="text-indigo-200 text-xs sm:text-sm mt-3 leading-relaxed">
          Sign in to access your orders, track neighborhood deliveries, and manage your wishlist at My Local Shop.
        </p>
      </div>
      <div class="hidden md:block mt-8 text-center text-xs text-amber-300 font-semibold bg-white/10 backdrop-blur-sm py-2 px-3 rounded-lg border border-white/10">
        <i class="fa-solid fa-shield-check mr-1"></i> Fast & Secure Local Checkout
      </div>
    </div>

    <!-- Right Login Form -->
    <div class="md:col-span-7 p-8 flex flex-col justify-between">
      <div>
        <!-- Auth Tabs -->
        <div class="flex border-b border-slate-200 mb-5 text-sm font-semibold">
          <a href="/login<%= redirect ? '?redirect=' + encodeURIComponent(redirect) : '' %>" 
             class="pb-2.5 px-4 border-b-2 border-indigo-600 text-indigo-600 font-bold">
            Sign In
          </a>
          <a href="/register<%= redirect ? '?redirect=' + encodeURIComponent(redirect) : '' %>" 
             class="pb-2.5 px-4 border-b-2 border-transparent text-slate-400 hover:text-slate-700 transition font-medium">
            Register
          </a>
        </div>

        <h3 class="text-lg font-black text-slate-800 mb-4">Sign in to My Local Shop</h3>
        <%- include('../partials/alerts') %>

        <form action="/login" method="POST" class="space-y-4 text-xs">
          <input type="hidden" name="redirect" value="<%= redirect %>">

          <div>
            <label class="block text-slate-600 font-semibold mb-1">Email Address *</label>
            <input type="email" id="emailInput" name="email" value="<%= (typeof email !== 'undefined' && email) ? email : '' %>" required placeholder="Enter your email" class="w-full p-2.5 border border-slate-300 rounded-lg focus:border-indigo-500 focus:ring-1 focus:ring-indigo-400 focus:outline-none text-xs">
          </div>

          <div>
            <div class="flex items-center justify-between mb-1">
              <label class="text-slate-600 font-semibold">Password *</label>
              <a href="/forgot-password" class="text-indigo-600 text-[11px] font-bold hover:underline">Forgot?</a>
            </div>
            <div class="relative">
              <input type="password" id="passwordInput" name="password" required placeholder="Enter password" class="w-full p-2.5 pr-10 border border-slate-300 rounded-lg focus:border-indigo-500 focus:ring-1 focus:ring-indigo-400 focus:outline-none text-xs">
              <button type="button" onclick="togglePasswordVisibility('passwordInput', this)" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-indigo-600 focus:outline-none text-sm p-1" title="Show or hide password" aria-label="Show password">
                <i class="fa-regular fa-eye"></i>
              </button>
            </div>
          </div>

          <button type="submit" class="btn-3d-amber w-full py-3 text-xs uppercase tracking-wider mt-2">
            Sign In to My Local Shop
          </button>
        </form>

      </div>

      <div class="mt-6 pt-4 border-t border-slate-100 text-center">
        <a href="/register" class="text-indigo-600 font-bold text-xs hover:underline">
          New to My Local Shop? Create an account
        </a>
      </div>

    </div>

  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
