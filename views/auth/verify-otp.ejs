<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow flex items-center justify-center py-12 px-4">
  <div class="max-w-md w-full bg-white rounded shadow-md p-8">
    
    <div class="text-center mb-6">
      <div class="w-14 h-14 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">
        <i class="fa-solid fa-shield-halved"></i>
      </div>
      <h2 class="text-xl font-bold text-gray-900">OTP Verification</h2>
      <p class="text-xs text-gray-500 mt-1">
        Please enter the 6-digit verification code sent to:<br>
        <strong class="text-gray-800"><%= email %></strong>
      </p>
    </div>

    <%- include('../partials/alerts') %>

    <div class="bg-blue-50 border border-blue-200 rounded p-3 mb-5 text-[11px] text-blue-900">
      <i class="fa-solid fa-info-circle mr-1 text-blue-600"></i>
      <strong>Developer Note:</strong> For easy testing without a configured SMTP server, the 6-digit OTP is automatically printed to your Node server terminal.
    </div>

    <form action="/verify-otp" method="POST" class="space-y-4">
      <input type="hidden" name="email" value="<%= email %>">
      <input type="hidden" name="role" value="<%= role %>">

      <div>
        <label class="block text-xs font-semibold text-gray-700 mb-1">Enter 6-digit OTP</label>
        <input 
          type="text" 
          name="otp" 
          maxlength="6" 
          required 
          autofocus 
          placeholder="••••••" 
          class="w-full text-center tracking-[0.5em] text-2xl font-bold py-3 border border-gray-300 rounded focus:border-blue-600 focus:outline-none"
        >
      </div>

      <button type="submit" class="w-full bg-[#fb641b] hover:bg-[#ea550d] text-white font-bold py-3 rounded-sm uppercase tracking-wider text-xs shadow">
        Verify & Continue
      </button>
    </form>

    <div class="mt-6 text-center text-xs text-gray-500">
      Didn't receive the code?
      <button onclick="resendOTP()" id="resendBtn" class="text-blue-600 font-bold hover:underline ml-1">
        Resend OTP
      </button>
      <div id="resendStatus" class="mt-2 text-xs font-semibold"></div>
    </div>

  </div>
</main>

<script>
  async function resendOTP() {
    const btn = document.getElementById('resendBtn');
    const status = document.getElementById('resendStatus');
    btn.disabled = true;
    status.innerText = 'Sending new OTP...';
    try {
      const res = await fetch('/resend-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: '<%= email %>', purpose: 'registration' })
      });
      const data = await res.json();
      if (data.success) {
        status.className = 'mt-2 text-xs font-semibold text-emerald-600';
        status.innerText = 'New OTP dispatched! Check terminal / inbox.';
      } else {
        status.className = 'mt-2 text-xs font-semibold text-red-600';
        status.innerText = data.message || 'Error resending OTP.';
      }
    } catch(e) {
      status.innerText = 'Network error while resending.';
    }
    setTimeout(() => { btn.disabled = false; }, 10000);
  }
</script>

<%- include('../partials/footer') %>
</body>
</html>
