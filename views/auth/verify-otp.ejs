<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow flex items-center justify-center py-12 px-4">
  <div class="max-w-md w-full bg-white rounded shadow-md p-8">
    
    <div class="text-center mb-6">
      <div class="w-14 h-14 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">
        <i class="fa-solid fa-envelope-circle-check"></i>
      </div>
      <h2 class="text-xl font-bold text-gray-900">Verify Your Email</h2>
      <p class="text-xs text-gray-600 mt-2 leading-relaxed">
        A secret 6-digit OTP verification code has been sent to your Gmail inbox:<br>
        <strong class="text-gray-900 font-bold text-sm block mt-1"><%= email %></strong>
      </p>
      <p class="text-[11px] text-gray-400 mt-1">
        Please check your Inbox (and Spam/Junk folder if not visible immediately).
      </p>
    </div>

    <%- include('../partials/alerts') %>

    <form action="/verify-otp" method="POST" class="space-y-5">
      <input type="hidden" name="email" value="<%= email %>">
      <input type="hidden" name="role" value="<%= role %>">
      <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '' %>">

      <div>
        <label class="block text-xs font-semibold text-gray-700 mb-1.5 text-center uppercase tracking-wider">
          Enter 6-Digit OTP From Your Inbox
        </label>
        <input 
          type="text" 
          name="otp" 
          value=""
          maxlength="6" 
          required 
          autofocus 
          placeholder="••••••" 
          autocomplete="one-time-code"
          class="w-full text-center tracking-[0.5em] text-2xl font-bold py-3.5 border-2 border-gray-300 rounded focus:border-blue-600 focus:outline-none bg-gray-50/50"
        >
      </div>

      <button type="submit" class="w-full bg-[#fb641b] hover:bg-[#ea550d] text-white font-bold py-3 rounded-sm uppercase tracking-wider text-xs shadow transition">
        Verify & Sign In
      </button>
    </form>

    <div class="mt-6 text-center text-xs text-gray-500">
      Didn't receive the code in your inbox?
      <button onclick="resendOTP()" id="resendBtn" class="text-blue-600 font-bold hover:underline ml-1">
        Resend to Gmail
      </button>
      <div id="resendStatus" class="mt-2 text-xs font-semibold"></div>
    </div>

  </div>
</main>

<script>
  async function resendOTP() {
    const btn = document.getElementById('resendBtn');
    const status = document.getElementById('resendStatus');
    btn.disabled = true;
    status.innerText = 'Sending new OTP to your inbox...';
    try {
      const res = await fetch('/resend-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: '<%= email %>', purpose: 'registration' })
      });
      const data = await res.json();
      if (data.success) {
        status.className = 'mt-2 text-xs font-semibold text-emerald-600';
        status.innerText = 'New OTP dispatched! Check your Gmail inbox.';
      } else {
        status.className = 'mt-2 text-xs font-semibold text-red-600';
        status.innerText = data.message || 'Error resending OTP.';
      }
    } catch(e) {
      status.innerText = 'Network error while resending.';
    }
    setTimeout(() => { btn.disabled = false; }, 8000);
  }
</script>

<%- include('../partials/footer') %>
</body>
</html>
