<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow flex items-center justify-center py-12 px-4">
  <div class="max-w-md w-full bg-white rounded shadow-md p-8">
    
    <div class="text-center mb-6">
      <div class="w-14 h-14 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl">
        <i class="fa-solid fa-shield-halved"></i>
      </div>
      <h2 class="text-xl font-bold text-gray-900">OTP Verification</h2>
      <p class="text-xs text-gray-500 mt-1">
        We have dispatched a 6-digit code to:<br>
        <strong class="text-gray-900 font-bold"><%= email %></strong>
      </p>
    </div>

    <%- include('../partials/alerts') %>

    <!-- Instant On-Screen OTP Code Display -->
    <% if (typeof demoOtp !== 'undefined' && demoOtp) { %>
      <div class="bg-gradient-to-r from-emerald-50 to-teal-50 border-2 border-emerald-400 rounded-lg p-4 mb-5 text-center shadow-sm">
        <div class="text-xs font-bold text-emerald-800 uppercase tracking-wider flex items-center justify-center gap-1.5 mb-1">
          <i class="fa-solid fa-circle-check text-emerald-600"></i> Your 6-Digit OTP Code:
        </div>
        <div class="text-3xl font-black text-emerald-700 tracking-[0.3em] font-mono bg-white inline-block px-5 py-1.5 rounded-md border border-emerald-300 shadow-sm my-1">
          <%= demoOtp %>
        </div>
        <div class="text-[11px] text-emerald-700 mt-1 font-medium">
          (Copy or enter this code below to verify immediately)
        </div>
      </div>
    <% } %>

    <form action="/verify-otp" method="POST" class="space-y-4">
      <input type="hidden" name="email" value="<%= email %>">
      <input type="hidden" name="role" value="<%= role %>">

      <div>
        <label class="block text-xs font-semibold text-gray-700 mb-1">Enter 6-Digit OTP Code</label>
        <input 
          type="text" 
          name="otp" 
          value="<%= typeof demoOtp !== 'undefined' && demoOtp ? demoOtp : '' %>"
          maxlength="6" 
          required 
          autofocus 
          placeholder="••••••" 
          class="w-full text-center tracking-[0.5em] text-2xl font-bold py-3 border border-gray-300 rounded focus:border-blue-600 focus:outline-none"
        >
      </div>

      <button type="submit" class="w-full bg-[#fb641b] hover:bg-[#ea550d] text-white font-bold py-3 rounded-sm uppercase tracking-wider text-xs shadow transition">
        Verify & Continue
      </button>
    </form>

    <div class="mt-6 text-center text-xs text-gray-500">
      Didn't receive the code?
      <button onclick="resendOTP()" id="resendBtn" class="text-blue-600 font-bold hover:underline ml-1">
        Resend OTP
      </button>
      <div id="resendStatus" class="mt-2 text-xs font-semibold"></div>
    </div>

  </div>
</main>

<script>
  async function resendOTP() {
    const btn = document.getElementById('resendBtn');
    const status = document.getElementById('resendStatus');
    btn.disabled = true;
    status.innerText = 'Dispatching new OTP...';
    try {
      const res = await fetch('/resend-otp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: '<%= email %>', purpose: 'registration' })
      });
      const data = await res.json();
      if (data.success) {
        status.className = 'mt-2 text-xs font-semibold text-emerald-600';
        status.innerText = 'New OTP code: ' + (data.otp || 'sent!');
        setTimeout(() => location.reload(), 1500);
      } else {
        status.className = 'mt-2 text-xs font-semibold text-red-600';
        status.innerText = data.message || 'Error resending OTP.';
      }
    } catch(e) {
      status.innerText = 'Network error while resending.';
    }
    setTimeout(() => { btn.disabled = false; }, 8000);
  }
</script>

<%- include('../partials/footer') %>
</body>
</html>
