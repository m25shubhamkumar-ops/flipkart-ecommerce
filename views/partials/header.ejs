<header class="bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white sticky top-0 z-50 shadow-xl border-b border-indigo-500/20 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">
      
      <!-- Brand Logo -->
      <div class="flex items-center space-x-2 flex-shrink-0">
        <a href="/" class="flex items-center gap-2.5 group">
          <span class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-400 via-amber-500 to-orange-500 flex items-center justify-center text-slate-950 shadow-lg shadow-amber-500/30 group-hover:scale-105 group-hover:rotate-3 transition duration-200 border border-amber-300/40">
            <i class="fa-solid fa-shop text-lg"></i>
          </span>
          <div class="flex flex-col items-start leading-none">
            <span class="text-xl sm:text-2xl font-black tracking-tight text-white group-hover:text-amber-300 transition-colors">
              My Local Shop
            </span>
            <span class="text-[10px] font-bold text-amber-400 tracking-wider flex items-center gap-1 mt-0.5">
              <i class="fa-solid fa-bolt text-[9px]"></i> Your Neighborhood Store
            </span>
          </div>
        </a>
      </div>

      <!-- Search Bar -->
      <div class="flex-1 max-w-2xl mx-2 hidden sm:block">
        <form action="/products" method="GET" class="relative flex items-center">
          <input 
            type="text" 
            name="search" 
            value="<%= typeof query !== 'undefined' && query.search ? query.search : '' %>"
            placeholder="Search products, groceries, daily essentials and more..." 
            class="w-full py-2.5 pl-5 pr-12 text-sm text-slate-900 bg-white/95 rounded-full shadow-inner border border-indigo-200/50 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:bg-white placeholder-slate-400 transition"
          />
          <button type="submit" class="absolute right-1 top-1 bottom-1 w-9 h-9 rounded-full bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-bold flex items-center justify-center shadow-md shadow-amber-500/20 transition">
            <i class="fa-solid fa-magnifying-glass text-xs"></i>
          </button>
        </form>
      </div>

      <!-- Right Navigation Actions -->
      <div class="flex items-center space-x-3 sm:space-x-5 text-sm font-medium">
        
        <% if (!currentUser) { %>
          <!-- Guest Navigation -->
          <a href="/login" class="btn-3d-amber text-xs sm:text-sm px-5 py-2">
            <i class="fa-regular fa-user mr-1.5 text-xs"></i> Sign In
          </a>
        <% } else { %>
          
          <!-- Role-Based Badge & Dropdown -->
          <% if (currentUser.role === 'admin') { %>
            <a href="/admin/dashboard" class="bg-gradient-to-r from-purple-600 to-indigo-600 text-white text-xs font-bold px-3 py-1.5 rounded-lg shadow-md shadow-purple-500/20 inline-flex items-center gap-1.5 hover:brightness-110 border border-purple-400/30">
              <i class="fa-solid fa-shield-halved"></i> Admin Panel
            </a>
          <% } else if (currentUser.role === 'delivery') { %>
            <a href="/delivery/dashboard" class="bg-gradient-to-r from-emerald-600 to-teal-600 text-white text-xs font-bold px-3 py-1.5 rounded-lg shadow-md shadow-emerald-500/20 inline-flex items-center gap-1.5 hover:brightness-110 border border-emerald-400/30">
              <i class="fa-solid fa-truck text-xs"></i> Delivery Portal
            </a>
          <% } %>

          <!-- User Account Menu -->
          <div class="relative group">
            <button class="flex items-center gap-1.5 hover:text-amber-300 py-2 focus:outline-none transition">
              <span class="w-7 h-7 rounded-full bg-indigo-800/80 border border-indigo-500/40 flex items-center justify-center text-xs font-bold text-amber-300">
                <%= currentUser.name.charAt(0).toUpperCase() %>
              </span>
              <span class="max-w-[110px] truncate font-semibold text-xs sm:text-sm"><%= currentUser.name %></span>
              <i class="fa-solid fa-chevron-down text-[10px] text-slate-400 group-hover:rotate-180 transition-transform duration-200"></i>
            </button>
            <div class="absolute right-0 w-56 bg-white text-slate-800 rounded-xl shadow-2xl py-2 hidden group-hover:block transition-all duration-200 z-50 border border-slate-100 divide-y divide-slate-100">
              <div class="px-4 py-2.5 text-xs text-slate-500 bg-slate-50 rounded-t-xl">
                Logged in as <strong class="capitalize text-indigo-600 font-bold"><%= currentUser.role %></strong>
              </div>

              <div class="py-1">
                <% if (currentUser.role === 'customer') { %>
                  <a href="/profile" class="block px-4 py-2 text-xs font-medium hover:bg-indigo-50 hover:text-indigo-600 transition">
                    <i class="fa-regular fa-user mr-2 text-indigo-500"></i> My Profile
                  </a>
                  <a href="/orders" class="block px-4 py-2 text-xs font-medium hover:bg-indigo-50 hover:text-indigo-600 transition">
                    <i class="fa-solid fa-box mr-2 text-indigo-500"></i> Orders
                  </a>
                  <a href="/wishlist" class="block px-4 py-2 text-xs font-medium hover:bg-indigo-50 hover:text-indigo-600 transition">
                    <i class="fa-regular fa-heart mr-2 text-indigo-500"></i> Wishlist
                  </a>
                  <a href="/profile/addresses" class="block px-4 py-2 text-xs font-medium hover:bg-indigo-50 hover:text-indigo-600 transition">
                    <i class="fa-solid fa-map-location-dot mr-2 text-indigo-500"></i> Addresses
                  </a>
                <% } else if (currentUser.role === 'delivery') { %>
                  <a href="/delivery/dashboard" class="block px-4 py-2 text-xs font-medium hover:bg-emerald-50 hover:text-emerald-700 transition">
                    <i class="fa-solid fa-gauge mr-2 text-emerald-600"></i> Dashboard
                  </a>
                  <a href="/delivery/orders" class="block px-4 py-2 text-xs font-medium hover:bg-emerald-50 hover:text-emerald-700 transition">
                    <i class="fa-solid fa-dolly mr-2 text-emerald-600"></i> Assigned Shipments
                  </a>
                  <a href="/delivery/history" class="block px-4 py-2 text-xs font-medium hover:bg-emerald-50 hover:text-emerald-700 transition">
                    <i class="fa-solid fa-clipboard-check mr-2 text-emerald-600"></i> Delivery History
                  </a>
                <% } else if (currentUser.role === 'admin') { %>
                  <a href="/admin/dashboard" class="block px-4 py-2 text-xs font-medium hover:bg-purple-50 hover:text-purple-700 transition">
                    <i class="fa-solid fa-chart-line mr-2 text-purple-600"></i> Admin Dashboard
                  </a>
                  <a href="/admin/orders" class="block px-4 py-2 text-xs font-medium hover:bg-purple-50 hover:text-purple-700 transition">
                    <i class="fa-solid fa-boxes-packing mr-2 text-purple-600"></i> Master Orders
                  </a>
                  <a href="/admin/returns" class="block px-4 py-2 text-xs font-medium hover:bg-purple-50 hover:text-purple-700 font-medium transition">
                    <i class="fa-solid fa-box-open mr-2 text-amber-500"></i> Returns & Refunds
                  </a>
                  <a href="/admin/products" class="block px-4 py-2 text-xs font-medium hover:bg-purple-50 hover:text-purple-700 transition">
                    <i class="fa-solid fa-tag mr-2 text-purple-600"></i> Product Catalog
                  </a>
                  <a href="/admin/users" class="block px-4 py-2 text-xs font-medium hover:bg-purple-50 hover:text-purple-700 transition">
                    <i class="fa-solid fa-users text-purple-600 mr-2"></i> Users & Roles
                  </a>
                <% } %>
              </div>

              <div class="py-1">
                <a href="/logout" class="block px-4 py-2 text-xs font-bold text-red-600 hover:bg-red-50 transition">
                  <i class="fa-solid fa-arrow-right-from-bracket mr-2"></i> Logout
                </a>
              </div>
            </div>
          </div>
        <% } %>

        <!-- Cart (Available for Customer & Guests) -->
        <a href="/cart" class="flex items-center gap-2 hover:text-amber-300 group relative py-1 px-2.5 rounded-lg hover:bg-white/10 transition">
          <div class="relative">
            <i class="fa-solid fa-cart-shopping text-lg"></i>
            <span id="headerCartBadge" 
                  class="absolute -top-2 -right-2 bg-gradient-to-r from-red-500 to-rose-600 text-white text-[10px] font-black rounded-full h-4 min-w-4 px-1 items-center justify-center shadow-md shadow-red-500/40 <%= (typeof cartCount !== 'undefined' && cartCount > 0) ? 'flex' : 'hidden' %>">
              <%= (typeof cartCount !== 'undefined' && cartCount > 0) ? cartCount : 0 %>
            </span>
          </div>
          <span class="font-bold hidden sm:inline text-xs uppercase tracking-wider">Cart</span>
        </a>

      </div>

    </div>
  </div>

  <!-- Mobile Search Form (Visible on Small Screens) -->
  <div class="sm:hidden px-4 pb-3">
    <form action="/products" method="GET" class="relative flex items-center">
      <input 
        type="text" 
        name="search" 
        value="<%= typeof query !== 'undefined' && query.search ? query.search : '' %>"
        placeholder="Search products, brands and more" 
        class="w-full py-2 pl-4 pr-10 text-xs text-slate-900 bg-white rounded-full shadow-inner focus:outline-none"
      />
      <button type="submit" class="absolute right-1 top-1 bottom-1 w-7 h-7 rounded-full bg-amber-400 text-slate-950 flex items-center justify-center">
        <i class="fa-solid fa-magnifying-glass text-[10px]"></i>
      </button>
    </form>
  </div>
</header>

<script>
  (function() {
    function updateCartUI(count) {
      const num = parseInt(count, 10) || 0;
      const badge = document.getElementById('headerCartBadge');
      if (badge) {
        badge.textContent = num;
        if (num > 0) {
          badge.classList.remove('hidden');
          badge.classList.add('flex');
        } else {
          badge.classList.remove('flex');
          badge.classList.add('hidden');
        }
      }
      try {
        localStorage.setItem('flipkart_cart_count', num);
      } catch (e) {}
    }

    // 1. Instant optimistic restore from localStorage (0ms latency on Back/Forward navigation)
    try {
      const cached = localStorage.getItem('flipkart_cart_count');
      if (cached !== null) {
        updateCartUI(cached);
      }
    } catch (e) {}

    // 2. Fetch live count from server
    async function syncCartCount() {
      try {
        const res = await fetch('/cart/count', {
          headers: { 'Accept': 'application/json' },
          cache: 'no-store'
        });
        if (res.ok) {
          const data = await res.json();
          if (data && typeof data.count === 'number') {
            updateCartUI(data.count);

            // If we are on a product page, also sync the Add to Cart / Go to Cart button!
            if (Array.isArray(data.productIds) && window.__CURRENT_PRODUCT_ID__) {
              const inCart = data.productIds.includes(window.__CURRENT_PRODUCT_ID__);
              const btn = document.getElementById('addToCartBtn');
              if (btn) {
                if (inCart) {
                  btn.dataset.inCart = 'true';
                  btn.className = 'flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-4 rounded-sm text-sm uppercase tracking-wider shadow flex items-center justify-center gap-2 transition-colors';
                  btn.innerHTML = '<i class="fa-solid fa-check"></i> Go to Cart';
                } else {
                  btn.dataset.inCart = 'false';
                  btn.className = 'flex-1 bg-[#ff9f00] hover:bg-[#f39700] text-white font-bold py-3 px-4 rounded-sm text-sm uppercase tracking-wider shadow flex items-center justify-center gap-2 disabled:opacity-50 transition-colors';
                  btn.innerHTML = '<i class="fa-solid fa-cart-shopping"></i> Add to Cart';
                }
              }
            }
          }
        }
      } catch (e) {
        // Silent fallback
      }
    }

    // Sync on initial load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncCartCount);
    } else {
      syncCartCount();
    }

    // Crucial: window.pageshow fires on Back/Forward navigation even when retrieved from BFCache!
    window.addEventListener('pageshow', function() {
      try {
        const cached = localStorage.getItem('flipkart_cart_count');
        if (cached !== null) {
          updateCartUI(cached);
        }
      } catch (e) {}
      syncCartCount();
    });

    // Also sync on window focus / tab switch
    window.addEventListener('focus', syncCartCount);

    // Global helper so product show or cart can update cart count immediately
    window.updateFlipkartCartCount = function(count) {
      updateCartUI(count);
    };
  })();
</script>
