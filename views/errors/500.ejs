<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow flex items-center justify-center py-16 px-4">
  <div class="max-w-md w-full bg-white p-8 rounded shadow-sm border border-amber-200 text-center">
    <div class="text-5xl font-black text-amber-500 mb-2">500</div>
    <h1 class="text-base font-bold text-gray-800 mb-2">Internal Server Error</h1>
    <p class="text-xs text-gray-600 mb-4 leading-relaxed">
      <%= typeof message !== 'undefined' ? message : 'Something went wrong while processing your request.' %>
    </p>
    <% if (typeof stack !== 'undefined' && stack) { %>
      <pre class="bg-gray-100 p-3 text-[10px] text-left overflow-x-auto text-red-700 rounded mb-4 max-h-40"><%= stack %></pre>
    <% } %>
    <a href="/" class="bg-blue-600 text-white font-bold text-xs px-6 py-2 rounded inline-block">
      Back to Homepage
    </a>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
