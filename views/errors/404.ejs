<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow flex items-center justify-center py-16 px-4">
  <div class="max-w-md w-full bg-white p-8 rounded shadow-sm border border-gray-200 text-center">
    <div class="text-6xl font-black text-[#2874f0] mb-2">404</div>
    <h1 class="text-lg font-bold text-gray-800 mb-2">Page Not Found</h1>
    <p class="text-xs text-gray-500 mb-6 leading-relaxed">
      <%= typeof message !== 'undefined' ? message : 'The page you are looking for does not exist or may have been moved.' %>
    </p>
    <a href="/" class="bg-[#2874f0] hover:bg-blue-700 text-white font-bold text-xs px-6 py-2.5 rounded shadow inline-flex items-center gap-2">
      <i class="fa-solid fa-house"></i> Go to Homepage
    </a>
  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
