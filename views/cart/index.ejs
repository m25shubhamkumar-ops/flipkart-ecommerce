<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow py-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <% if (!items || items.length === 0) { %>
      <!-- Empty Cart State -->
      <div class="bg-white p-12 text-center rounded-sm shadow-sm border border-gray-200 max-w-2xl mx-auto">
        <div class="w-32 h-32 mx-auto mb-4 flex items-center justify-center">
          <i class="fa-solid fa-cart-arrow-down text-7xl text-gray-300"></i>
        </div>
        <h2 class="text-lg font-bold text-gray-800">Your cart is empty!</h2>
        <p class="text-xs text-gray-500 mt-1 mb-6">Explore our wide selection and find something you love.</p>
        <a href="/products" class="inline-block bg-[#2874f0] hover:bg-blue-700 text-white font-bold text-sm px-8 py-2.5 rounded-sm shadow transition">
          Shop Now
        </a>
      </div>
    <% } else { %>
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Cart Items List (8 Columns) -->
        <div class="lg:col-span-8 bg-white rounded-sm shadow-sm border border-gray-200 divide-y divide-gray-200">
          
          <div class="p-4 flex items-center justify-between border-b">
            <h1 class="text-base font-bold text-gray-900">Flipkart Cart (<%= items.length %> items)</h1>
            <span class="text-xs text-gray-500">Deliver to: <strong class="text-gray-800">Default Address</strong></span>
          </div>

          <% items.forEach(item => { %>
            <div class="p-4 sm:p-6 flex flex-col sm:flex-row gap-4 items-start">
              
              <!-- Item Image & Stepper -->
              <div class="flex flex-col items-center gap-3 flex-shrink-0 mx-auto sm:mx-0">
                <a href="/products/<%= item.productId.slug %>" class="w-24 h-24 flex items-center justify-center overflow-hidden">
                  <img src="<%= item.productId.images && item.productId.images[0] ? item.productId.images[0] : 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=200' %>" 
                       alt="<%= item.productId.name %>" 
                       class="max-h-full max-w-full object-contain">
                </a>

                <!-- Stepper -->
                <div class="flex items-center gap-2">
                  <form action="/cart/update" method="POST" class="inline">
                    <input type="hidden" name="productId" value="<%= item.productId._id %>">
                    <input type="hidden" name="action" value="dec">
                    <button type="submit" class="w-7 h-7 rounded-full border border-gray-300 flex items-center justify-center text-xs font-bold text-gray-600 hover:bg-gray-100">
                      -
                    </button>
                  </form>
                  <span class="w-8 text-center text-xs font-bold border border-gray-200 py-1 rounded bg-gray-50"><%= item.quantity %></span>
                  <form action="/cart/update" method="POST" class="inline">
                    <input type="hidden" name="productId" value="<%= item.productId._id %>">
                    <input type="hidden" name="action" value="inc">
                    <button type="submit" <%= item.quantity >= item.productId.stock ? 'disabled' : '' %> class="w-7 h-7 rounded-full border border-gray-300 flex items-center justify-center text-xs font-bold text-gray-600 hover:bg-gray-100 disabled:opacity-40">
                      +
                    </button>
                  </form>
                </div>
              </div>

              <!-- Item Details -->
              <div class="flex-grow space-y-1">
                <a href="/products/<%= item.productId.slug %>" class="text-sm font-medium text-gray-900 hover:text-blue-600 leading-snug line-clamp-2">
                  <%= item.productId.name %>
                </a>
                <div class="text-[11px] text-gray-400 font-semibold uppercase"><%= item.productId.brand %></div>

                <!-- Price Breakdown -->
                <div class="flex items-baseline gap-2 pt-2">
                  <span class="text-base font-bold text-gray-900">
                    <%= formatPrice((item.productId.discountPrice > 0 ? item.productId.discountPrice : item.productId.price) * item.quantity) %>
                  </span>
                  <% if (item.productId.discountPrice > 0 && item.productId.discountPrice < item.productId.price) { %>
                    <span class="text-xs text-gray-400 line-through">
                      <%= formatPrice(item.productId.price * item.quantity) %>
                    </span>
                    <span class="text-xs font-bold text-emerald-600">
                      <%= Math.round(((item.productId.price - item.productId.discountPrice) / item.productId.price) * 100) %>% Off
                    </span>
                  <% } %>
                </div>

                <!-- Actions: Remove -->
                <div class="pt-3 flex gap-4 text-xs font-bold text-gray-700">
                  <form action="/cart/remove" method="POST" class="inline">
                    <input type="hidden" name="productId" value="<%= item.productId._id %>">
                    <button type="submit" class="hover:text-red-600 uppercase tracking-wide">
                      Remove
                    </button>
                  </form>
                  <form action="/wishlist/toggle" method="POST" class="inline">
                    <input type="hidden" name="productId" value="<%= item.productId._id %>">
                    <button type="submit" class="hover:text-blue-600 uppercase tracking-wide">
                      Save for Later
                    </button>
                  </form>
                </div>
              </div>

              <!-- Delivery Promise -->
              <div class="text-xs text-gray-500 sm:text-right flex-shrink-0">
                <span>Delivery in 2 - 3 Days | <span class="text-emerald-600 font-bold">Free</span></span>
              </div>

            </div>
          <% }) %>

          <!-- Bottom Checkout Trigger Bar -->
          <div class="p-4 bg-white sticky bottom-0 border-t shadow-inner flex justify-end">
            <a href="/checkout" class="bg-[#fb641b] hover:bg-[#ea550d] text-white font-bold py-3 px-10 rounded-sm text-sm uppercase tracking-wider shadow">
              Place Order
            </a>
          </div>

        </div>

        <!-- Right Side: Price Details (4 Columns) -->
        <div class="lg:col-span-4 bg-white rounded-sm shadow-sm border border-gray-200 sticky top-20">
          <div class="p-4 border-b border-gray-200">
            <h2 class="text-xs font-bold text-gray-400 uppercase tracking-wider">Price Details</h2>
          </div>

          <div class="p-4 space-y-3 text-xs text-gray-700">
            <div class="flex justify-between">
              <span>Price (<%= items.length %> items)</span>
              <span class="font-medium"><%= formatPrice(totals.subtotal) %></span>
            </div>

            <div class="flex justify-between text-emerald-600 font-medium">
              <span>Discount</span>
              <span>- <%= formatPrice(totals.totalDiscount) %></span>
            </div>

            <div class="flex justify-between">
              <span>Delivery Charges</span>
              <span>
                <% if (totals.shipping === 0) { %>
                  <span class="text-emerald-600 font-bold">FREE</span>
                <% } else { %>
                  <span class="font-medium"><%= formatPrice(totals.shipping) %></span>
                <% } %>
              </span>
            </div>

            <div class="border-t border-dashed border-gray-200 pt-3 flex justify-between text-sm font-black text-gray-900">
              <span>Total Amount</span>
              <span><%= formatPrice(totals.grandTotal) %></span>
            </div>

            <% if (totals.totalDiscount > 0) { %>
              <div class="pt-2 text-emerald-600 font-bold text-[11px] border-t border-gray-100">
                You will save <%= formatPrice(totals.totalDiscount) %> on this order
              </div>
            <% } %>
          </div>

          <!-- Trust Badges -->
          <div class="p-4 border-t border-gray-100 text-[11px] text-gray-400 flex items-center gap-2">
            <i class="fa-solid fa-shield-halved text-gray-400 text-lg"></i>
            <span>Safe and Secure Payments. Easy returns. 100% Authentic products.</span>
          </div>

        </div>

      </div>

    <% } %>

  </div>
</main>

<script>
  (function() {
    <% const totalQuantity = items && items.length > 0 ? items.reduce((s, i) => s + (i.quantity || 1), 0) : 0; %>
    const currentCartQty = <%= totalQuantity %>;
    if (window.updateFlipkartCartCount) {
      window.updateFlipkartCartCount(currentCartQty);
    } else {
      try {
        localStorage.setItem('flipkart_cart_count', currentCartQty);
      } catch (e) {}
    }
  })();
</script>

<%- include('../partials/footer') %>
</body>
</html>
