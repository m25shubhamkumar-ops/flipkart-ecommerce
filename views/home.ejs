<%- include('partials/head') %>
<%- include('partials/header') %>

<main class="flex-grow py-5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    
    <!-- 3D Category Strip -->
    <div class="bg-white/90 backdrop-blur-md shadow-md rounded-2xl border border-slate-200/80 p-4 sm:p-5">
      <div class="flex items-center justify-between overflow-x-auto no-scrollbar gap-5 text-center">
        <% if (categories && categories.length > 0) { %>
          <% categories.forEach(cat => { %>
            <a href="/products?category=<%= cat.slug %>" class="group flex flex-col items-center flex-shrink-0 min-w-[80px]">
              <div class="w-16 h-16 mb-2 rounded-full orb-3d flex items-center justify-center p-1 overflow-hidden relative">
                <% if (cat.image) { %>
                  <img src="<%= cat.image %>" alt="<%= cat.name %>" referrerpolicy="no-referrer" class="w-full h-full object-cover rounded-full group-hover:scale-110 transition duration-300">
                <% } else { %>
                  <i class="fa-solid fa-layer-group text-indigo-600 text-xl"></i>
                <% } %>
              </div>
              <span class="text-xs font-bold text-slate-800 group-hover:text-indigo-600 transition tracking-tight"><%= cat.name %></span>
            </a>
          <% }) %>
        <% } %>
      </div>
    </div>

    <!-- 3D Hero Banner -->
    <div class="relative overflow-hidden rounded-2xl shadow-2xl bg-gradient-to-br from-slate-950 via-indigo-950 to-blue-900 text-white p-7 sm:p-12 border border-indigo-500/20">
      <!-- Ambient Glow Orbs in background -->
      <div class="absolute -right-16 -top-16 w-80 h-80 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -right-8 -bottom-8 w-72 h-72 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative max-w-xl space-y-4">
        <div class="inline-flex items-center gap-2 bg-gradient-to-r from-amber-400 to-amber-500 text-slate-950 font-black text-xs px-3.5 py-1 rounded-full uppercase tracking-wider shadow-lg shadow-amber-500/30">
          <i class="fa-solid fa-bolt text-xs"></i> Neighborhood Mega Savings 2026
        </div>
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight text-white drop-shadow-sm">
          Shop Fresh & Fast at <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-yellow-200 to-amber-400">My Local Shop</span>
        </h1>
        <p class="text-slate-300 text-sm sm:text-base font-normal leading-relaxed">
          Bringing you high-quality electronics, authentic local groceries, trending fashion, and home essentials delivered right to your doorstep.
        </p>
        <div class="pt-2 flex flex-wrap gap-3.5">
          <a href="/products" class="btn-3d-amber text-xs sm:text-sm px-6 py-3">
            <i class="fa-solid fa-bag-shopping mr-2"></i> Explore Local Deals
          </a>
          <% if (!currentUser) { %>
            <a href="/register" class="btn-3d-white text-xs sm:text-sm px-6 py-3">
              <i class="fa-solid fa-user-plus mr-2 text-indigo-600"></i> Join My Local Shop
            </a>
          <% } %>
        </div>
      </div>
    </div>

    <!-- 10-Minute Express Quick-Commerce Strip -->
    <div class="bg-gradient-to-r from-amber-500 via-orange-500 to-amber-600 rounded-2xl p-4 sm:p-5 shadow-xl text-slate-950 flex flex-col md:flex-row items-center justify-between gap-4 card-3d">
      <div class="flex items-center gap-4 text-center md:text-left">
        <div class="w-14 h-14 rounded-2xl bg-slate-950 text-amber-400 flex items-center justify-center text-3xl font-black shadow-xl flex-shrink-0 animate-pulse">
          ⚡
        </div>
        <div>
          <div class="inline-flex items-center gap-2 bg-slate-950 text-amber-300 font-black text-[10px] px-2.5 py-0.5 rounded-full uppercase tracking-wider mb-1">
            <i class="fa-solid fa-clock"></i> Hyperlocal Quick Commerce
          </div>
          <h2 class="text-xl sm:text-2xl font-black tracking-tight text-slate-950">
            Need Groceries, Milk, or Medicines in 10 Minutes?
          </h2>
          <p class="text-xs sm:text-sm font-semibold text-slate-900/90 mt-0.5">
            Order fresh daily staples, breakfast essentials & first-aid with <strong>Guaranteed 10-Minute Express Delivery</strong>.
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3 flex-shrink-0">
        <a href="/products?category=groceries" class="bg-slate-950 hover:bg-slate-900 text-amber-400 font-black text-xs px-5 py-3 rounded-xl uppercase tracking-wider shadow-lg transition flex items-center gap-1.5">
          <i class="fa-solid fa-basket-shopping"></i> Groceries
        </a>
        <a href="/products?category=medicines-health" class="bg-white hover:bg-slate-100 text-slate-950 font-black text-xs px-5 py-3 rounded-xl uppercase tracking-wider shadow-lg transition flex items-center gap-1.5">
          <i class="fa-solid fa-kit-medical text-rose-600"></i> Medicines
        </a>
      </div>
    </div>

    <!-- Deals of the Day (3D Cards) -->
    <% if (dealProducts && dealProducts.length > 0) { %>
      <div class="bg-white p-5 sm:p-6 rounded-2xl shadow-sm border border-slate-200/80">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-5">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center font-bold">
              <i class="fa-solid fa-fire text-sm"></i>
            </span>
            <div>
              <h2 class="text-lg sm:text-xl font-black text-slate-900 tracking-tight">Today's Hot Deals</h2>
              <p class="text-xs text-slate-500">Limited-time neighborhood special pricing</p>
            </div>
          </div>
          <a href="/products" class="btn-3d-white text-xs px-3.5 py-1.5 text-indigo-600 font-bold">
            VIEW ALL <i class="fa-solid fa-chevron-right text-[10px] ml-1"></i>
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
          <% dealProducts.forEach(product => { %>
            <a href="/products/<%= product.slug %>" class="card-3d group flex flex-col p-3 text-center">
              <div class="h-36 w-full flex items-center justify-center mb-2.5 overflow-hidden bg-gradient-to-b from-slate-50 to-slate-100/60 rounded-xl p-2">
                <img src="<%= product.images && product.images[0] ? product.images[0] : 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400' %>" 
                     alt="<%= product.name %>" 
                     referrerpolicy="no-referrer"
                     class="max-h-full max-w-full object-contain group-hover:scale-105 transition duration-300">
              </div>
              <h3 class="text-xs font-bold text-slate-800 truncate group-hover:text-indigo-600 transition"><%= product.name %></h3>
              <div class="mt-1.5">
                <span class="text-xs font-black text-emerald-600">From <%= formatPrice(product.discountPrice > 0 ? product.discountPrice : product.price) %></span>
                <% if (product.discountPrice > 0 && product.discountPrice < product.price) { %>
                  <div class="text-[11px] text-slate-400 line-through"><%= formatPrice(product.price) %></div>
                <% } %>
              </div>
              <div class="text-[10px] font-semibold text-slate-400 mt-1 uppercase tracking-wider"><%= product.brand %></div>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- Featured Products (3D Grid) -->
    <div class="bg-white p-5 sm:p-6 rounded-2xl shadow-sm border border-slate-200/80">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-6">
        <div>
          <h2 class="text-lg sm:text-xl font-black text-slate-900 tracking-tight">Featured Neighborhood Catalog</h2>
          <p class="text-xs text-slate-500">Trending handpicked essentials with verified local delivery</p>
        </div>
        <a href="/products" class="text-indigo-600 hover:text-indigo-800 text-xs sm:text-sm font-bold flex items-center gap-1 transition">
          Explore All <i class="fa-solid fa-chevron-right text-[10px]"></i>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        <% if (featuredProducts && featuredProducts.length > 0) { %>
          <% featuredProducts.forEach(product => { %>
            <div class="card-3d group p-4 flex flex-col justify-between">
              
              <div>
                <!-- Product Image Pedestal -->
                <a href="/products/<%= product.slug %>" class="block h-48 w-full mb-3.5 flex items-center justify-center overflow-hidden bg-gradient-to-b from-slate-50 to-slate-100/70 rounded-xl p-3">
                  <img src="<%= product.images && product.images[0] ? product.images[0] : 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400' %>" 
                       alt="<%= product.name %>" 
                       referrerpolicy="no-referrer"
                       class="max-h-full max-w-full object-contain group-hover:scale-105 transition duration-300">
                </a>

                <!-- Details -->
                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1"><%= product.brand %></div>
                <a href="/products/<%= product.slug %>" class="text-sm font-bold text-slate-900 group-hover:text-indigo-600 line-clamp-2 leading-snug transition">
                  <%= product.name %>
                </a>

                <!-- Rating & Local Assured Badge -->
                <div class="flex items-center gap-2 mt-2.5">
                  <span class="inline-flex items-center gap-0.5 bg-emerald-600 text-white text-[11px] font-black px-1.5 py-0.5 rounded shadow-xs">
                    <%= product.ratingAvg || 4.2 %> <i class="fa-solid fa-star text-[9px]"></i>
                  </span>
                  <span class="text-xs text-slate-400">(<%= product.ratingCount || 120 %>)</span>
                  <span class="ml-auto inline-flex items-center gap-1 bg-indigo-50 text-indigo-700 text-[10px] font-extrabold px-2 py-0.5 rounded-full border border-indigo-100">
                    <i class="fa-solid fa-shield-check text-indigo-500"></i> Local Assured
                  </span>
                </div>

                <!-- Price -->
                <div class="flex items-baseline gap-2 mt-2.5">
                  <span class="text-lg font-black text-slate-900">
                    <%= formatPrice(product.discountPrice > 0 ? product.discountPrice : product.price) %>
                  </span>
                  <% if (product.discountPrice > 0 && product.discountPrice < product.price) { %>
                    <span class="text-xs text-slate-400 line-through"><%= formatPrice(product.price) %></span>
                    <span class="text-xs font-black text-emerald-600">
                      <%= Math.round(((product.price - product.discountPrice) / product.price) * 100) %>% off
                    </span>
                  <% } %>
                </div>
              </div>

              <!-- 3D Add to Cart Button -->
              <div class="mt-4 pt-3 border-t border-slate-100">
                <form action="/cart/add" method="POST">
                  <input type="hidden" name="productId" value="<%= product._id %>">
                  <button type="submit" class="btn-3d-amber w-full py-2.5 text-xs">
                    <i class="fa-solid fa-cart-plus mr-1.5"></i> ADD TO CART
                  </button>
                </form>
              </div>

            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

  </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
