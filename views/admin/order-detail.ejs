<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow py-6">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    
    <div class="flex items-center justify-between">
      <a href="/admin/orders" class="text-xs font-bold text-purple-700 hover:underline inline-flex items-center gap-1">
        <i class="fa-solid fa-arrow-left"></i> Back to Orders
      </a>
      <span class="text-xs text-gray-500">Order ID: #<%= order.orderNumber %></span>
    </div>

    <!-- Admin Control Box: Status & Assignment -->
    <div class="bg-white rounded-sm shadow-sm border border-purple-300 p-6">
      <h1 class="text-base font-bold text-gray-900 mb-4 border-b pb-3">Admin Order Management & Dispatch</h1>

      <form action="/admin/orders/<%= order._id %>/status" method="POST" class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        
        <div>
          <label class="block font-bold text-gray-700 mb-1">Confirm / Update Order Status</label>
          <select name="orderStatus" class="w-full p-2.5 border rounded bg-white font-bold text-gray-800">
            <optgroup label="Forward Logistics">
              <option value="Placed" <%= order.orderStatus === 'Placed' ? 'selected' : '' %>>Placed (New Order)</option>
              <option value="Confirmed" <%= order.orderStatus === 'Confirmed' ? 'selected' : '' %>>Confirmed (Accept Order)</option>
              <option value="Packed" <%= order.orderStatus === 'Packed' ? 'selected' : '' %>>Packed at Warehouse</option>
              <option value="Shipped" <%= order.orderStatus === 'Shipped' ? 'selected' : '' %>>Shipped (In-Transit)</option>
              <option value="Out for Delivery" <%= order.orderStatus === 'Out for Delivery' ? 'selected' : '' %>>Out for Delivery</option>
              <option value="Delivered" <%= order.orderStatus === 'Delivered' ? 'selected' : '' %>>Delivered (Order Completed)</option>
              <option value="Cancelled" <%= order.orderStatus === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
            </optgroup>
            <optgroup label="Reverse Logistics (Returns & Refunds)">
              <option value="Return Requested" <%= order.orderStatus === 'Return Requested' ? 'selected' : '' %>>Return Requested</option>
              <option value="Return Confirmed" <%= (order.orderStatus === 'Return Confirmed' || order.orderStatus === 'Return Approved') ? 'selected' : '' %>>Return Confirmed (Approve Pickup)</option>
              <option value="Out for Return" <%= order.orderStatus === 'Out for Return' ? 'selected' : '' %>>Out for Return (Pickup In-Progress)</option>
              <option value="Return Picked Up" <%= order.orderStatus === 'Return Picked Up' ? 'selected' : '' %>>Return Picked Up (Collected)</option>
              <option value="Returned & Refunded" <%= order.orderStatus === 'Returned & Refunded' ? 'selected' : '' %>>Returned & Refunded (Completed)</option>
              <option value="Return Cancelled" <%= order.orderStatus === 'Return Cancelled' ? 'selected' : '' %>>Return Cancelled</option>
              <option value="Return Rejected" <%= order.orderStatus === 'Return Rejected' ? 'selected' : '' %>>Return Rejected</option>
            </optgroup>
          </select>
        </div>

        <div>
          <label class="block font-bold text-gray-700 mb-1">Confirm / Update Payment Status</label>
          <select name="paymentStatus" class="w-full p-2.5 border rounded bg-white font-bold text-gray-800">
            <option value="pending" <%= order.paymentStatus === 'pending' ? 'selected' : '' %>>⏳ Pending (Payment Awaited / COD)</option>
            <option value="completed" <%= order.paymentStatus === 'completed' ? 'selected' : '' %>>✅ Completed / Received</option>
            <option value="failed" <%= order.paymentStatus === 'failed' ? 'selected' : '' %>>❌ Failed</option>
            <option value="refunded" <%= order.paymentStatus === 'refunded' ? 'selected' : '' %>>↩️ Refunded</option>
          </select>
        </div>

        <div>
          <label class="block font-bold text-gray-700 mb-1">Assign Delivery Agent</label>
          <select name="deliveryAgentId" class="w-full p-2.5 border rounded bg-white font-bold text-gray-800">
            <option value="">-- No Agent Assigned --</option>
            <% deliveryAgents.forEach(agent => { %>
              <option value="<%= agent._id %>" <%= (order.deliveryAgentId && (order.deliveryAgentId._id || order.deliveryAgentId).toString() === agent._id.toString()) ? 'selected' : '' %>>
                🚚 <%= agent.name %> (<%= agent.email %>)
              </option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block font-bold text-gray-700 mb-1">Admin Dispatch / Internal Notes</label>
          <input type="text" name="notes" placeholder="e.g. Verified payment via UPI, dispatched from Bengaluru Hub" class="w-full p-2.5 border rounded text-xs">
        </div>


        <div class="sm:col-span-2 flex justify-end">
          <button type="submit" class="bg-purple-700 hover:bg-purple-800 text-white font-bold py-2.5 px-8 rounded text-xs uppercase tracking-wider shadow">
            Save Changes
          </button>
        </div>

      </form>
    </div>

    <!-- Return / Cancellation Details Banner if active -->
    <% if (order.returnDetails && order.returnDetails.status !== 'none') { %>
      <div class="bg-amber-50 border-2 border-amber-300 rounded p-5 text-xs space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="font-bold text-amber-900 text-sm flex items-center gap-1.5">
            <i class="fa-solid fa-box-open text-amber-600"></i> Customer Return / Replacement Request
          </h3>
          <span class="px-2 py-0.5 rounded font-bold uppercase text-[10px] <%= order.returnDetails.status === 'refunded' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-200 text-amber-900' %>">
            Status: <%= order.returnDetails.status %>
          </span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-gray-700">
          <div>
            <strong>Reason:</strong> <%= order.returnDetails.reason %><br>
            <strong>Customer Notes:</strong> <%= order.returnDetails.comments || 'None' %><br>
            <strong>Preferred Resolution:</strong> <span class="uppercase font-bold text-purple-800"><%= order.returnDetails.resolution %></span>
          </div>
          <div>
            <strong>Requested At:</strong> <%= formatDate(order.returnDetails.requestedAt) %><br>
            <strong>Refund Destination:</strong> 
            <%= order.refundDetails?.payoutDetails?.upiId ? 'UPI: ' + order.refundDetails.payoutDetails.upiId : (order.refundDetails?.payoutDetails?.bankAccount ? 'Bank A/C: ' + order.refundDetails.payoutDetails.bankAccount : order.paymentMethod) %><br>
            <% if (order.returnDetails.adminRemarks) { %>
              <strong>Admin Note:</strong> <%= order.returnDetails.adminRemarks %>
            <% } %>
          </div>
        </div>

        <div class="pt-2 border-t border-amber-200 flex flex-wrap gap-2 justify-end">
          <a href="/admin/returns" class="bg-purple-700 hover:bg-purple-800 text-white font-bold px-4 py-2 rounded text-xs shadow-sm">
            Process in Returns & Refunds Queue →
          </a>
        </div>
      </div>
    <% } %>

    <% if (order.cancellationDetails && order.cancellationDetails.cancelledAt) { %>
      <div class="bg-red-50 border border-red-200 rounded p-4 text-xs space-y-1 text-red-900">
        <div class="font-bold text-sm"><i class="fa-solid fa-circle-xmark text-red-600"></i> Order Cancelled by <%= order.cancellationDetails.cancelledBy %></div>
        <div><strong>Cancellation Reason:</strong> <%= order.cancellationDetails.reason %></div>
        <% if (order.cancellationDetails.comments) { %>
          <div><strong>Comments:</strong> <%= order.cancellationDetails.comments %></div>
        <% } %>
        <div class="text-[11px] text-red-700">Cancelled on: <%= formatDate(order.cancellationDetails.cancelledAt) %></div>
      </div>
    <% } %>

    <!-- Order Items and Customer Snapshot -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">

      <div class="bg-white p-5 rounded-sm border border-gray-200 space-y-2">
        <h3 class="font-bold text-gray-400 uppercase tracking-wider text-[10px]">Customer & Destination</h3>
        <div class="font-bold text-sm text-gray-900"><%= order.addressSnapshot.fullName %></div>
        <div class="text-gray-600"><%= order.addressSnapshot.line1 %>, <%= order.addressSnapshot.city %> - <%= order.addressSnapshot.pincode %></div>
        <div class="text-gray-700">Phone: <%= order.addressSnapshot.phone %></div>
        <div class="text-gray-500">Email: <%= order.userId ? order.userId.email : 'N/A' %></div>
      </div>

      <div class="bg-white p-5 rounded-sm border border-gray-200 space-y-2">
        <h3 class="font-bold text-gray-400 uppercase tracking-wider text-[10px]">Financial Summary</h3>
        <div class="flex justify-between"><span>Subtotal:</span><span><%= formatPrice(order.totals.subtotal) %></span></div>
        <div class="flex justify-between text-emerald-600"><span>Discount:</span><span>-<%= formatPrice(order.totals.discount) %></span></div>
        <div class="flex justify-between"><span>Shipping:</span><span><%= order.totals.shipping === 0 ? 'FREE' : formatPrice(order.totals.shipping) %></span></div>
        <div class="border-t pt-1 flex justify-between font-black text-sm"><span>Grand Total:</span><span><%= formatPrice(order.totals.grandTotal) %></span></div>
        <div class="text-[11px] text-gray-500">Payment: <%= order.paymentMethod %> (<%= order.paymentStatus %>)</div>
      </div>
    </div>

    <!-- Timeline History -->
    <div class="bg-white p-5 rounded-sm border border-gray-200 text-xs">
      <h3 class="font-bold text-gray-400 uppercase tracking-wider text-[10px] mb-3">Timeline Events</h3>
      <div class="space-y-2">
        <% order.statusTimeline.slice().reverse().forEach(evt => { %>
          <div class="flex justify-between border-b pb-1">
            <span><strong><%= evt.status %></strong>: <%= evt.message %></span>
            <span class="text-gray-400"><%= formatDate(evt.timestamp) %></span>
          </div>
        <% }) %>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
