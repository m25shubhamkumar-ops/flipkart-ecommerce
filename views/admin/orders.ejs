<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow py-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
    
    <div class="bg-white p-4 rounded-sm shadow-sm border border-gray-200 flex flex-wrap items-center justify-between gap-4 text-xs">
      <div>
        <h1 class="text-base font-bold text-gray-900">Master Orders Queue & Dispatch (<%= orders.length %>)</h1>
        <span class="text-gray-500">Monitor all orders, dispatch packages, and assign delivery agents.</span>
      </div>

      <!-- Filters -->
      <div class="flex flex-wrap items-center gap-2">
        <a href="/admin/orders?status=all" class="px-3 py-1.5 rounded border <%= currentFilter === 'all' ? 'bg-purple-700 text-white font-bold' : 'hover:bg-gray-50' %>">
          All
        </a>
        <a href="/admin/orders?status=Placed" class="px-3 py-1.5 rounded border <%= currentFilter === 'Placed' ? 'bg-purple-700 text-white font-bold' : 'hover:bg-gray-50' %>">
          Placed
        </a>
        <a href="/admin/orders?status=Confirmed" class="px-3 py-1.5 rounded border <%= currentFilter === 'Confirmed' ? 'bg-purple-700 text-white font-bold' : 'hover:bg-gray-50' %>">
          Confirmed
        </a>
        <a href="/admin/orders?status=Out for Delivery" class="px-3 py-1.5 rounded border <%= currentFilter === 'Out for Delivery' ? 'bg-purple-700 text-white font-bold' : 'hover:bg-gray-50' %>">
          Out for Delivery
        </a>
        <a href="/admin/orders?status=Delivered" class="px-3 py-1.5 rounded border <%= currentFilter === 'Delivered' ? 'bg-purple-700 text-white font-bold' : 'hover:bg-gray-50' %>">
          Delivered
        </a>
      </div>
    </div>

    <!-- Orders Table -->
    <div class="bg-white rounded-sm shadow-sm border border-gray-200 overflow-x-auto text-xs">
      <table class="w-full text-left">
        <thead class="bg-gray-50 text-gray-500 uppercase text-[10px]">
          <tr>
            <th class="p-3">Order Number</th>
            <th class="p-3">Date</th>
            <th class="p-3">Customer</th>
            <th class="p-3">Items</th>
            <th class="p-3">Total</th>
            <th class="p-3">Status</th>
            <th class="p-3">Assigned Delivery Agent</th>
            <th class="p-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% orders.forEach(order => { %>
            <tr class="hover:bg-gray-50">
              <td class="p-3 font-bold text-gray-900">#<%= order.orderNumber %></td>
              <td class="p-3 text-gray-500"><%= formatDate(order.createdAt) %></td>
              <td class="p-3">
                <div class="font-medium text-gray-900"><%= order.addressSnapshot.fullName %></div>
                <div class="text-gray-400 text-[11px]"><%= order.addressSnapshot.city %>, <%= order.addressSnapshot.pincode %></div>
              </td>
              <td class="p-3 text-gray-600"><%= order.items.length %> item(s)</td>
              <td class="p-3">
                <span class="font-bold"><%= formatPrice(order.totals.grandTotal) %></span>
                <span class="text-[10px] text-gray-400 block uppercase"><%= order.paymentMethod %></span>
              </td>
              <td class="p-3">
                <span class="text-[10px] font-bold px-2 py-0.5 rounded <%= order.orderStatus === 'Delivered' ? 'bg-emerald-100 text-emerald-800' : (order.orderStatus === 'Cancelled' ? 'bg-red-100 text-red-800' : 'bg-blue-100 text-blue-800') %>">
                  <%= order.orderStatus %>
                </span>
              </td>

              <!-- Inline Delivery Agent Assignment Form -->
              <td class="p-3">
                <form action="/admin/orders/<%= order._id %>/status" method="POST" class="flex items-center gap-1.5">
                  <select name="deliveryAgentId" class="p-1 border rounded bg-white text-[11px] max-w-[140px]" onchange="this.form.submit()">
                    <option value="">-- Assign Agent --</option>
                    <% deliveryAgents.forEach(agent => { %>
                      <option value="<%= agent._id %>" <%= (order.deliveryAgentId && (order.deliveryAgentId._id || order.deliveryAgentId).toString() === agent._id.toString()) ? 'selected' : '' %>>
                        <%= agent.name %>
                      </option>
                    <% }) %>
                  </select>
                  <input type="hidden" name="orderStatus" value="<%= order.orderStatus === 'Placed' ? 'Confirmed' : order.orderStatus %>">
                </form>
              </td>

              <td class="p-3 text-right">
                <a href="/admin/orders/<%= order._id %>" class="bg-purple-100 hover:bg-purple-200 text-purple-800 font-bold px-3 py-1.5 rounded text-[11px]">
                  Manage
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
