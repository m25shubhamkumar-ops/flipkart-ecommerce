<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow py-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
    
    <div class="bg-white p-4 rounded-sm shadow-sm border border-gray-200 flex flex-wrap items-center justify-between gap-4 text-xs">
      <div>
        <h1 class="text-base font-bold text-gray-900">Product Catalog Management (<%= products.length %>)</h1>
        <span class="text-gray-500">Add, edit, change pricing, and monitor stock levels.</span>
      </div>

      <div class="flex items-center gap-3">
        <form action="/admin/products" method="GET" class="flex gap-2">
          <input type="text" name="search" value="<%= query.search || '' %>" placeholder="Search product/brand..." class="p-1.5 border rounded text-xs">
          <button type="submit" class="bg-gray-100 hover:bg-gray-200 px-3 py-1.5 rounded font-bold">Search</button>
        </form>
        <a href="/admin/products/new" class="bg-[#2874f0] hover:bg-blue-700 text-white font-bold px-4 py-2 rounded shadow inline-flex items-center gap-1.5">
          <i class="fa-solid fa-plus"></i> Add Product
        </a>
      </div>
    </div>

    <!-- Products Table -->
    <div class="bg-white rounded-sm shadow-sm border border-gray-200 overflow-x-auto text-xs">
      <table class="w-full text-left">
        <thead class="bg-gray-50 text-gray-500 uppercase text-[10px]">
          <tr>
            <th class="p-3">Product</th>
            <th class="p-3">Category</th>
            <th class="p-3">Brand</th>
            <th class="p-3">List Price</th>
            <th class="p-3">Discount Price</th>
            <th class="p-3">Stock</th>
            <th class="p-3">Status</th>
            <th class="p-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% products.forEach(prod => { %>
            <tr class="hover:bg-gray-50">
              <td class="p-3">
                <div class="flex items-center gap-2">
                  <img src="<%= prod.images && prod.images[0] ? prod.images[0] : '' %>" class="w-10 h-10 object-contain border rounded p-0.5">
                  <div>
                    <div class="font-bold text-gray-900 line-clamp-1 max-w-xs"><%= prod.name %></div>
                    <div class="text-gray-400 text-[10px]">Slug: <%= prod.slug %></div>
                  </div>
                </div>
              </td>
              <td class="p-3"><%= prod.categoryId ? prod.categoryId.name : 'N/A' %></td>
              <td class="p-3 font-medium"><%= prod.brand %></td>
              <td class="p-3"><%= formatPrice(prod.price) %></td>
              <td class="p-3 font-bold text-emerald-700"><%= prod.discountPrice ? formatPrice(prod.discountPrice) : '-' %></td>
              <td class="p-3">
                <% if (prod.stock <= 5) { %>
                  <span class="bg-red-100 text-red-800 font-bold px-2 py-0.5 rounded text-[10px]">
                    <%= prod.stock %> units (Low)
                  </span>
                <% } else { %>
                  <span class="font-bold text-gray-800"><%= prod.stock %> units</span>
                <% } %>
              </td>
              <td class="p-3">
                <span class="<%= prod.isActive ? 'text-emerald-700 bg-emerald-50' : 'text-gray-500 bg-gray-100' %> font-bold px-2 py-0.5 rounded text-[10px]">
                  <%= prod.isActive ? 'Active' : 'Draft' %>
                </span>
              </td>
              <td class="p-3 text-right space-x-2">
                <a href="/admin/products/<%= prod._id %>/edit" class="text-blue-600 hover:text-blue-800 font-bold">
                  Edit
                </a>
                <form action="/admin/products/<%= prod._id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete this product permanently?')">
                  <button type="submit" class="text-red-600 hover:text-red-800 font-bold">
                    Delete
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
