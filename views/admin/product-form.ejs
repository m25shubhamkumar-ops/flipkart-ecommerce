<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow py-6">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="mb-4">
      <a href="/admin/products" class="text-xs font-bold text-purple-700 hover:underline inline-flex items-center gap-1">
        <i class="fa-solid fa-arrow-left"></i> Back to Products
      </a>
    </div>

    <div class="bg-white rounded-sm shadow-sm border border-gray-200 p-6">
      <h1 class="text-lg font-bold text-gray-900 mb-4 border-b pb-3">
        <%= product && product._id ? 'Edit Product: ' + product.name : 'Create New Product' %>
      </h1>

      <%- include('../partials/alerts') %>

      <form action="<%= product && product._id ? '/admin/products/' + product._id + '/edit' : '/admin/products' %>" method="POST" class="space-y-4 text-xs">
        
        <div>
          <label class="block font-bold text-gray-700 mb-1">Product Title / Name *</label>
          <input type="text" name="name" value="<%= product ? product.name : '' %>" required placeholder="e.g. Apple iPhone 15 Pro Max (256 GB)" class="w-full p-2.5 border rounded text-xs">
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-gray-700 mb-1">Category *</label>
            <select name="categoryId" required class="w-full p-2.5 border rounded bg-white text-xs">
              <option value="">-- Select Category --</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat._id %>" <%= (product && (product.categoryId?._id || product.categoryId)?.toString() === cat._id.toString()) ? 'selected' : '' %>>
                  <%= cat.name %>
                </option>
              <% }) %>
            </select>
          </div>

          <div>
            <label class="block font-bold text-gray-700 mb-1">Brand Name</label>
            <input type="text" name="brand" value="<%= product ? product.brand : '' %>" placeholder="e.g. Apple, Samsung, Nike" class="w-full p-2.5 border rounded text-xs">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block font-bold text-gray-700 mb-1">List MRP (₹) *</label>
            <input type="number" name="price" value="<%= product ? product.price : '' %>" required min="1" placeholder="999" class="w-full p-2.5 border rounded text-xs">
          </div>

          <div>
            <label class="block font-bold text-gray-700 mb-1">Offer / Discount Price (₹)</label>
            <input type="number" name="discountPrice" value="<%= product ? product.discountPrice : '' %>" min="0" placeholder="799" class="w-full p-2.5 border rounded text-xs">
          </div>

          <div>
            <label class="block font-bold text-gray-700 mb-1">Stock Quantity *</label>
            <input type="number" name="stock" value="<%= product ? product.stock : 10 %>" required min="0" class="w-full p-2.5 border rounded text-xs">
          </div>
        </div>

        <div>
          <label class="block font-bold text-gray-700 mb-1">Image URLs (comma-separated)</label>
          <input type="text" name="images" value="<%= product && product.images ? product.images.join(', ') : '' %>" placeholder="https://image-url-1.jpg, https://image-url-2.jpg" class="w-full p-2.5 border rounded text-xs">
          <span class="text-[10px] text-gray-400">Add direct URLs to product photos or leave empty for default placeholder.</span>
        </div>

        <div>
          <label class="block font-bold text-gray-700 mb-1">Detailed Description *</label>
          <textarea name="description" rows="5" required placeholder="Highlight product features, warranty, in-box contents..." class="w-full p-2.5 border rounded text-xs"><%= product ? product.description : '' %></textarea>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <input type="checkbox" id="isActive" name="isActive" <%= !product || product.isActive ? 'checked' : '' %> class="text-blue-600">
          <label for="isActive" class="font-bold text-gray-700 cursor-pointer">Publish as Active in Marketplace</label>
        </div>

        <div class="pt-4 border-t flex justify-end gap-3">
          <a href="/admin/products" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-2 px-5 rounded text-xs">Cancel</a>
          <button type="submit" class="bg-[#2874f0] hover:bg-blue-700 text-white font-bold py-2 px-8 rounded text-xs uppercase tracking-wider shadow">
            <%= product && product._id ? 'Update Product' : 'Save Product' %>
          </button>
        </div>

      </form>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
