<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow py-6">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    
    <div class="bg-white p-4 rounded-sm shadow-sm border border-gray-200 flex items-center justify-between text-xs">
      <div>
        <h1 class="text-base font-bold text-gray-900">Category Catalog (<%= categories.length %>)</h1>
        <span class="text-gray-500">Manage categories displayed in top navigation and filters.</span>
      </div>
      <a href="/admin/dashboard" class="text-purple-700 font-bold hover:underline">Back to Dashboard</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      
      <!-- Create Category Form (4 cols) -->
      <div class="md:col-span-4 bg-white p-5 rounded-sm shadow-sm border border-gray-200 text-xs">
        <h2 class="font-bold text-gray-900 border-b pb-2 mb-3">Add New Category</h2>
        <form action="/admin/categories" method="POST" class="space-y-3">
          <div>
            <label class="block font-semibold mb-1">Category Name *</label>
            <input type="text" name="name" required placeholder="e.g. Smart Watches" class="w-full p-2 border rounded text-xs">
          </div>
          <div>
            <label class="block font-semibold mb-1">Image URL (Optional)</label>
            <input type="text" name="image" placeholder="https://..." class="w-full p-2 border rounded text-xs">
          </div>
          <button type="submit" class="w-full bg-[#2874f0] hover:bg-blue-700 text-white font-bold py-2 rounded text-xs">
            Create Category
          </button>
        </form>
      </div>

      <!-- Categories Table (8 cols) -->
      <div class="md:col-span-8 bg-white rounded-sm shadow-sm border border-gray-200 overflow-x-auto text-xs">
        <table class="w-full text-left">
          <thead class="bg-gray-50 text-gray-500 uppercase text-[10px]">
            <tr>
              <th class="p-3">Category</th>
              <th class="p-3">Slug</th>
              <th class="p-3">Status</th>
              <th class="p-3 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% categories.forEach(cat => { %>
              <tr class="hover:bg-gray-50">
                <td class="p-3 font-bold text-gray-900 flex items-center gap-2">
                  <% if (cat.image) { %>
                    <img src="<%= cat.image %>" class="w-8 h-8 rounded-full object-contain border p-0.5">
                  <% } %>
                  <span><%= cat.name %></span>
                </td>
                <td class="p-3 text-gray-500 font-mono text-[11px]"><%= cat.slug %></td>
                <td class="p-3">
                  <span class="bg-emerald-50 text-emerald-700 font-bold px-2 py-0.5 rounded text-[10px]">Active</span>
                </td>
                <td class="p-3 text-right">
                  <form action="/admin/categories/<%= cat._id %>/delete" method="POST" class="inline" onsubmit="return confirm('Delete category?')">
                    <button type="submit" class="text-red-600 hover:text-red-800 font-bold">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

    </div>

  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
