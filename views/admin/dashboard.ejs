<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow py-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    
    <!-- Admin Header Banner -->
    <div class="bg-gradient-to-r from-purple-800 via-indigo-800 to-blue-900 text-white p-6 rounded-md shadow flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-1.5 bg-purple-950/60 text-purple-200 text-xs px-2.5 py-0.5 rounded font-bold uppercase tracking-wider mb-2">
          <i class="fa-solid fa-shield-halved"></i> Master Control Panel
        </div>
        <h1 class="text-2xl font-black">Flipkart Admin Center</h1>
        <p class="text-xs text-purple-200 mt-1">Logged in as Administrator: <%= currentUser.name %> (<%= currentUser.email %>)</p>
      </div>

      <div class="flex flex-wrap gap-2 text-xs">
        <a href="/admin/products/new" class="bg-[#ffe500] hover:bg-yellow-400 text-gray-900 font-bold px-4 py-2 rounded shadow transition inline-flex items-center gap-1.5">
          <i class="fa-solid fa-plus"></i> Add Product
        </a>
        <a href="/admin/orders" class="bg-white/20 hover:bg-white/30 text-white font-bold px-4 py-2 rounded transition inline-flex items-center gap-1.5">
          <i class="fa-solid fa-boxes-packing"></i> Orders Queue
        </a>
        <a href="/admin/login-activity" class="bg-white/20 hover:bg-white/30 text-white font-bold px-4 py-2 rounded transition inline-flex items-center gap-1.5">
          <i class="fa-solid fa-user-shield"></i> Audit Trail
        </a>
      </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 text-xs">
      
      <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200">
        <div class="text-gray-500 font-medium uppercase tracking-wider text-[10px]">Total Revenue</div>
        <div class="text-xl sm:text-2xl font-black text-gray-900 mt-1"><%= formatPrice(stats.totalRevenue) %></div>
      </div>

      <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200">
        <div class="text-gray-500 font-medium uppercase tracking-wider text-[10px]">Total Orders</div>
        <div class="text-xl sm:text-2xl font-black text-blue-600 mt-1"><%= stats.totalOrders %></div>
      </div>

      <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200">
        <div class="text-gray-500 font-medium uppercase tracking-wider text-[10px]">Customers</div>
        <div class="text-xl sm:text-2xl font-black text-emerald-600 mt-1"><%= stats.totalUsers %></div>
      </div>

      <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200">
        <div class="text-gray-500 font-medium uppercase tracking-wider text-[10px]">Delivery Agents</div>
        <div class="text-xl sm:text-2xl font-black text-teal-600 mt-1"><%= stats.totalDeliveryAgents %></div>
      </div>

      <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200">
        <div class="text-gray-500 font-medium uppercase tracking-wider text-[10px]">Low Stock Alert</div>
        <div class="text-xl sm:text-2xl font-black text-red-600 mt-1"><%= stats.lowStockProducts %></div>
      </div>

    </div>

    <!-- Sales Trends & Revenue Analytics (Daily / Weekly Stretch Goal) -->
    <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b pb-4 mb-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-blue-50 text-blue-600">
              <i class="fa-solid fa-chart-line text-sm"></i>
            </span>
            <div>
              <h2 class="text-sm sm:text-base font-bold text-gray-900">Sales Trends & Revenue Velocity</h2>
              <p class="text-xs text-gray-500">Live order volume and gross revenue trends across daily and weekly intervals</p>
            </div>
          </div>
        </div>

        <!-- Timeframe Controls & Summary -->
        <div class="flex flex-wrap items-center gap-3">
          <!-- Toggle Buttons -->
          <div class="inline-flex rounded border border-gray-200 p-0.5 bg-gray-100 text-xs font-semibold" role="group">
            <button type="button" id="btnDailyTrend" class="px-3 py-1.5 rounded text-xs font-bold transition bg-white text-blue-600 shadow-sm">
              <i class="fa-regular fa-calendar-day mr-1"></i> Daily (7 Days)
            </button>
            <button type="button" id="btnWeeklyTrend" class="px-3 py-1.5 rounded text-xs font-bold transition text-gray-600 hover:text-gray-900">
              <i class="fa-solid fa-calendar-week mr-1"></i> Weekly (4 Weeks)
            </button>
          </div>

          <!-- Period Metrics Summary -->
          <div class="hidden sm:flex items-center gap-2.5 pl-3 border-l border-gray-200 text-xs">
            <div>
              <span class="text-gray-500 block text-[10px] uppercase font-semibold">Period Total</span>
              <span id="trendPeriodTotal" class="font-black text-emerald-600 text-xs sm:text-sm">
                <%= formatPrice(salesTrend.daily.totalRevenue) %>
              </span>
            </div>
            <div class="h-6 w-px bg-gray-200"></div>
            <div>
              <span class="text-gray-500 block text-[10px] uppercase font-semibold">Orders</span>
              <span id="trendPeriodOrders" class="font-bold text-gray-900 text-xs sm:text-sm">
                <%= salesTrend.daily.totalOrders %>
              </span>
            </div>
            <div class="h-6 w-px bg-gray-200"></div>
            <div>
              <span class="text-gray-500 block text-[10px] uppercase font-semibold">AOV</span>
              <span id="trendPeriodAov" class="font-bold text-blue-600 text-xs sm:text-sm">
                <%= formatPrice(salesTrend.daily.aov) %>
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Chart Container -->
      <div class="relative w-full h-72 sm:h-80">
        <canvas id="salesTrendChart"></canvas>
        <div id="chartFallbackContainer" class="hidden absolute inset-0 flex flex-col items-center justify-center bg-gray-50 p-4 text-center rounded border border-gray-200">
          <i class="fa-solid fa-chart-simple text-3xl text-gray-400 mb-2"></i>
          <p class="text-xs font-semibold text-gray-700">Interactive chart could not be initialized.</p>
          <p class="text-[11px] text-gray-500 mt-1">Total revenue: <%= formatPrice(salesTrend.daily.totalRevenue) %> (<%= salesTrend.daily.totalOrders %> orders)</p>
        </div>
      </div>

      <!-- Legend & Axis Indicators -->
      <div class="flex flex-wrap items-center justify-between gap-2 pt-3 mt-3 border-t border-gray-100 text-[11px] text-gray-500">
        <div class="flex items-center gap-4">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-1 bg-[#2874f0] rounded-full inline-block"></span>
            <span class="font-medium text-gray-700">Gross Sales (₹)</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 bg-indigo-200 border border-indigo-500 rounded-sm inline-block"></span>
            <span class="font-medium text-gray-700">Order Units</span>
          </div>
        </div>
        <div class="text-[11px] text-gray-400 italic">
          <i class="fa-solid fa-circle-info mr-1"></i> Excludes cancelled orders
        </div>
      </div>
    </div>

    <!-- Quick Sections Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- Recent Orders Queue (8 cols) -->
      <div class="lg:col-span-8 bg-white p-5 rounded-sm shadow-sm border border-gray-200">
        <div class="flex items-center justify-between border-b pb-3 mb-4">
          <h2 class="text-sm font-bold text-gray-900">Recent Customer Orders</h2>
          <a href="/admin/orders" class="text-xs text-blue-600 font-bold hover:underline">View All Orders</a>
        </div>

        <% if (!recentOrders || recentOrders.length === 0) { %>
          <p class="text-xs text-gray-500 py-6 text-center italic">No orders received yet.</p>
        <% } else { %>
          <div class="overflow-x-auto text-xs">
            <table class="w-full text-left">
              <thead class="bg-gray-50 text-gray-500 uppercase text-[10px]">
                <tr>
                  <th class="p-2.5">Order ID</th>
                  <th class="p-2.5">Customer</th>
                  <th class="p-2.5">Amount</th>
                  <th class="p-2.5">Assigned Agent</th>
                  <th class="p-2.5">Status</th>
                  <th class="p-2.5 text-right">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% recentOrders.forEach(ord => { %>
                  <tr class="hover:bg-gray-50">
                    <td class="p-2.5 font-bold">#<%= ord.orderNumber %></td>
                    <td class="p-2.5"><%= ord.userId ? ord.userId.name : ord.addressSnapshot.fullName %></td>
                    <td class="p-2.5 font-bold"><%= formatPrice(ord.totals.grandTotal) %></td>
                    <td class="p-2.5">
                      <% if (ord.deliveryAgentId) { %>
                        <span class="text-emerald-700 font-bold"><i class="fa-solid fa-truck text-[10px]"></i> <%= ord.deliveryAgentId.name %></span>
                      <% } else { %>
                        <span class="text-amber-600 italic">Unassigned</span>
                      <% } %>
                    </td>
                    <td class="p-2.5">
                      <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-gray-100 text-gray-800">
                        <%= ord.orderStatus %>
                      </span>
                    </td>
                    <td class="p-2.5 text-right">
                      <a href="/admin/orders/<%= ord._id %>" class="text-blue-600 font-bold hover:underline">Manage</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <!-- Low Stock Warnings & Quick Navigation (4 cols) -->
      <div class="lg:col-span-4 space-y-4 text-xs">
        
        <!-- Low stock panel -->
        <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200">
          <h3 class="font-bold text-gray-900 border-b pb-2 mb-3 flex items-center justify-between">
            <span>Inventory Warnings (<%= lowStockList.length %>)</span>
            <i class="fa-solid fa-triangle-exclamation text-amber-500"></i>
          </h3>
          <% if (lowStockList.length === 0) { %>
            <p class="text-gray-500 italic py-2">All inventory levels are healthy.</p>
          <% } else { %>
            <div class="space-y-2">
              <% lowStockList.forEach(prod => { %>
                <div class="flex items-center justify-between p-2 rounded bg-red-50 text-red-900">
                  <span class="truncate max-w-[160px] font-medium"><%= prod.name %></span>
                  <span class="font-bold bg-red-200 text-red-800 px-2 py-0.5 rounded text-[10px]">
                    <%= prod.stock %> left
                  </span>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

        <!-- Management shortcuts -->
        <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200 space-y-2">
          <h3 class="font-bold text-gray-900 border-b pb-2 mb-3">Administrative Hub</h3>
          <a href="/admin/products" class="flex items-center justify-between p-2 rounded hover:bg-purple-50 text-gray-700 hover:text-purple-700 transition">
            <span><i class="fa-solid fa-tag text-purple-600 mr-2"></i> Manage Products</span>
            <i class="fa-solid fa-chevron-right text-[10px]"></i>
          </a>
          <a href="/admin/categories" class="flex items-center justify-between p-2 rounded hover:bg-purple-50 text-gray-700 hover:text-purple-700 transition">
            <span><i class="fa-solid fa-layer-group text-purple-600 mr-2"></i> Manage Categories</span>
            <i class="fa-solid fa-chevron-right text-[10px]"></i>
          </a>
          <a href="/admin/users" class="flex items-center justify-between p-2 rounded hover:bg-purple-50 text-gray-700 hover:text-purple-700 transition">
            <span><i class="fa-solid fa-users text-purple-600 mr-2"></i> Users & Role Assignment</span>
            <i class="fa-solid fa-chevron-right text-[10px]"></i>
          </a>
          <a href="/admin/login-activity" class="flex items-center justify-between p-2 rounded hover:bg-purple-50 text-gray-700 hover:text-purple-700 transition">
            <span><i class="fa-solid fa-user-shield text-purple-600 mr-2"></i> Authentication Audit Logs</span>
            <i class="fa-solid fa-chevron-right text-[10px]"></i>
          </a>
        </div>

      </div>

    </div>

  </div>
</main>

<!-- Chart.js 4.x CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

<!-- Embedded Sales Trend Data -->
<script id="salesTrendDataScript" type="application/json">
  <%- JSON.stringify(salesTrend) %>
</script>

<script>
  (function() {
    // Utility to format numbers as Indian Rupee currency
    function formatINR(val) {
      if (val === null || val === undefined || isNaN(val)) return '₹0';
      return '₹' + Number(val).toLocaleString('en-IN');
    }

    const dataElement = document.getElementById('salesTrendDataScript');
    let salesData = null;
    try {
      salesData = JSON.parse(dataElement.textContent || '{}');
    } catch (e) {
      console.error('Failed to parse salesTrend data', e);
    }

    if (!salesData || !salesData.daily || !salesData.weekly) {
      console.warn('Sales trend data unavailable.');
      return;
    }

    // Safety fallback if Chart.js is not loaded
    if (typeof Chart === 'undefined') {
      const fallback = document.getElementById('chartFallbackContainer');
      const canvas = document.getElementById('salesTrendChart');
      if (fallback && canvas) {
        fallback.classList.remove('hidden');
        canvas.classList.add('hidden');
      }
      return;
    }

    const ctx = document.getElementById('salesTrendChart').getContext('2d');
    let currentMode = 'daily'; // 'daily' or 'weekly'

    // Button and metric elements
    const btnDaily = document.getElementById('btnDailyTrend');
    const btnWeekly = document.getElementById('btnWeeklyTrend');
    const metricPeriodTotal = document.getElementById('trendPeriodTotal');
    const metricPeriodOrders = document.getElementById('trendPeriodOrders');
    const metricPeriodAov = document.getElementById('trendPeriodAov');

    // Chart.js Configuration
    const trendChart = new Chart(ctx, {
      data: {
        labels: salesData.daily.labels,
        datasets: [
          {
            type: 'line',
            label: 'Gross Sales (₹)',
            data: salesData.daily.revenue,
            borderColor: '#2874f0',
            backgroundColor: 'rgba(40, 116, 240, 0.12)',
            borderWidth: 2.5,
            fill: true,
            tension: 0.35,
            pointBackgroundColor: '#2874f0',
            pointBorderColor: '#ffffff',
            pointBorderWidth: 2,
            pointRadius: 4,
            pointHoverRadius: 6,
            yAxisID: 'y'
          },
          {
            type: 'bar',
            label: 'Order Volume',
            data: salesData.daily.orderCounts,
            backgroundColor: 'rgba(99, 102, 241, 0.35)',
            borderColor: '#6366f1',
            borderWidth: 1.5,
            borderRadius: 4,
            maxBarThickness: 28,
            yAxisID: 'y1'
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
          mode: 'index',
          intersect: false
        },
        plugins: {
          legend: {
            display: false // Using custom bottom legend
          },
          tooltip: {
            backgroundColor: 'rgba(17, 24, 39, 0.95)',
            titleFont: { size: 12, weight: 'bold' },
            bodyFont: { size: 11 },
            padding: 10,
            cornerRadius: 6,
            callbacks: {
              label: function(context) {
                if (context.datasetIndex === 0) {
                  return ' Gross Sales: ' + formatINR(context.raw);
                } else {
                  return ' Orders Placed: ' + context.raw + ' units';
                }
              }
            }
          }
        },
        scales: {
          x: {
            grid: {
              display: false
            },
            ticks: {
              font: { size: 11, weight: '500' },
              color: '#6b7280'
            }
          },
          y: {
            type: 'linear',
            display: true,
            position: 'left',
            beginAtZero: true,
            grid: {
              color: 'rgba(0, 0, 0, 0.05)',
              strokeDash: [3, 3]
            },
            ticks: {
              font: { size: 10 },
              color: '#6b7280',
              callback: function(value) {
                if (value >= 10000000) return '₹' + (value / 10000000).toFixed(1) + 'Cr';
                if (value >= 100000) return '₹' + (value / 100000).toFixed(1) + 'L';
                if (value >= 1000) return '₹' + (value / 1000).toFixed(0) + 'k';
                return '₹' + value;
              }
            }
          },
          y1: {
            type: 'linear',
            display: true,
            position: 'right',
            beginAtZero: true,
            grid: {
              display: false
            },
            ticks: {
              precision: 0,
              font: { size: 10 },
              color: '#818cf8',
              callback: function(value) {
                return value + ' ord';
              }
            }
          }
        }
      }
    });

    // Update UI Function for Toggling
    function setTrendMode(mode) {
      currentMode = mode;
      const data = mode === 'daily' ? salesData.daily : salesData.weekly;

      // Update button styling
      if (mode === 'daily') {
        btnDaily.className = 'px-3 py-1.5 rounded text-xs font-bold transition bg-white text-blue-600 shadow-sm';
        btnWeekly.className = 'px-3 py-1.5 rounded text-xs font-bold transition text-gray-600 hover:text-gray-900';
      } else {
        btnWeekly.className = 'px-3 py-1.5 rounded text-xs font-bold transition bg-white text-blue-600 shadow-sm';
        btnDaily.className = 'px-3 py-1.5 rounded text-xs font-bold transition text-gray-600 hover:text-gray-900';
      }

      // Update Chart.js data
      trendChart.data.labels = data.labels;
      trendChart.data.datasets[0].data = data.revenue;
      trendChart.data.datasets[1].data = data.orderCounts;
      trendChart.update();

      // Update Header Metrics
      if (metricPeriodTotal) metricPeriodTotal.textContent = formatINR(data.totalRevenue);
      if (metricPeriodOrders) metricPeriodOrders.textContent = data.totalOrders;
      if (metricPeriodAov) metricPeriodAov.textContent = formatINR(data.aov);
    }

    // Attach listeners
    if (btnDaily) {
      btnDaily.addEventListener('click', function() {
        if (currentMode !== 'daily') setTrendMode('daily');
      });
    }

    if (btnWeekly) {
      btnWeekly.addEventListener('click', function() {
        if (currentMode !== 'weekly') setTrendMode('weekly');
      });
    }
  })();
</script>

<%- include('../partials/footer') %>
</body>
</html>
