<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow py-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    
    <!-- Admin Header Banner -->
    <div class="bg-gradient-to-r from-purple-800 via-indigo-800 to-blue-900 text-white p-6 rounded-md shadow flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-1.5 bg-purple-950/60 text-purple-200 text-xs px-2.5 py-0.5 rounded font-bold uppercase tracking-wider mb-2">
          <i class="fa-solid fa-shield-halved"></i> Master Control Panel
        </div>
        <h1 class="text-2xl font-black">Flipkart Admin Center</h1>
        <p class="text-xs text-purple-200 mt-1">Logged in as Administrator: <%= currentUser.name %> (<%= currentUser.email %>)</p>
      </div>

      <div class="flex flex-wrap gap-2 text-xs">
        <a href="/admin/products/new" class="bg-[#ffe500] hover:bg-yellow-400 text-gray-900 font-bold px-4 py-2 rounded shadow transition inline-flex items-center gap-1.5">
          <i class="fa-solid fa-plus"></i> Add Product
        </a>
        <a href="/admin/orders" class="bg-white/20 hover:bg-white/30 text-white font-bold px-4 py-2 rounded transition inline-flex items-center gap-1.5">
          <i class="fa-solid fa-boxes-packing"></i> Orders Queue
        </a>
        <a href="/admin/login-activity" class="bg-white/20 hover:bg-white/30 text-white font-bold px-4 py-2 rounded transition inline-flex items-center gap-1.5">
          <i class="fa-solid fa-user-shield"></i> Audit Trail
        </a>
      </div>
    </div>

    <!-- KPI Metric Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 text-xs">
      
      <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200">
        <div class="text-gray-500 font-medium uppercase tracking-wider text-[10px]">Total Revenue</div>
        <div class="text-xl sm:text-2xl font-black text-gray-900 mt-1"><%= formatPrice(stats.totalRevenue) %></div>
      </div>

      <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200">
        <div class="text-gray-500 font-medium uppercase tracking-wider text-[10px]">Total Orders</div>
        <div class="text-xl sm:text-2xl font-black text-blue-600 mt-1"><%= stats.totalOrders %></div>
      </div>

      <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200">
        <div class="text-gray-500 font-medium uppercase tracking-wider text-[10px]">Customers</div>
        <div class="text-xl sm:text-2xl font-black text-emerald-600 mt-1"><%= stats.totalUsers %></div>
      </div>

      <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200">
        <div class="text-gray-500 font-medium uppercase tracking-wider text-[10px]">Delivery Agents</div>
        <div class="text-xl sm:text-2xl font-black text-teal-600 mt-1"><%= stats.totalDeliveryAgents %></div>
      </div>

      <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200">
        <div class="text-gray-500 font-medium uppercase tracking-wider text-[10px]">Low Stock Alert</div>
        <div class="text-xl sm:text-2xl font-black text-red-600 mt-1"><%= stats.lowStockProducts %></div>
      </div>

    </div>

    <!-- Quick Sections Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- Recent Orders Queue (8 cols) -->
      <div class="lg:col-span-8 bg-white p-5 rounded-sm shadow-sm border border-gray-200">
        <div class="flex items-center justify-between border-b pb-3 mb-4">
          <h2 class="text-sm font-bold text-gray-900">Recent Customer Orders</h2>
          <a href="/admin/orders" class="text-xs text-blue-600 font-bold hover:underline">View All Orders</a>
        </div>

        <% if (!recentOrders || recentOrders.length === 0) { %>
          <p class="text-xs text-gray-500 py-6 text-center italic">No orders received yet.</p>
        <% } else { %>
          <div class="overflow-x-auto text-xs">
            <table class="w-full text-left">
              <thead class="bg-gray-50 text-gray-500 uppercase text-[10px]">
                <tr>
                  <th class="p-2.5">Order ID</th>
                  <th class="p-2.5">Customer</th>
                  <th class="p-2.5">Amount</th>
                  <th class="p-2.5">Assigned Agent</th>
                  <th class="p-2.5">Status</th>
                  <th class="p-2.5 text-right">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% recentOrders.forEach(ord => { %>
                  <tr class="hover:bg-gray-50">
                    <td class="p-2.5 font-bold">#<%= ord.orderNumber %></td>
                    <td class="p-2.5"><%= ord.userId ? ord.userId.name : ord.addressSnapshot.fullName %></td>
                    <td class="p-2.5 font-bold"><%= formatPrice(ord.totals.grandTotal) %></td>
                    <td class="p-2.5">
                      <% if (ord.deliveryAgentId) { %>
                        <span class="text-emerald-700 font-bold"><i class="fa-solid fa-truck text-[10px]"></i> <%= ord.deliveryAgentId.name %></span>
                      <% } else { %>
                        <span class="text-amber-600 italic">Unassigned</span>
                      <% } %>
                    </td>
                    <td class="p-2.5">
                      <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-gray-100 text-gray-800">
                        <%= ord.orderStatus %>
                      </span>
                    </td>
                    <td class="p-2.5 text-right">
                      <a href="/admin/orders/<%= ord._id %>" class="text-blue-600 font-bold hover:underline">Manage</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <!-- Low Stock Warnings & Quick Navigation (4 cols) -->
      <div class="lg:col-span-4 space-y-4 text-xs">
        
        <!-- Low stock panel -->
        <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200">
          <h3 class="font-bold text-gray-900 border-b pb-2 mb-3 flex items-center justify-between">
            <span>Inventory Warnings (<%= lowStockList.length %>)</span>
            <i class="fa-solid fa-triangle-exclamation text-amber-500"></i>
          </h3>
          <% if (lowStockList.length === 0) { %>
            <p class="text-gray-500 italic py-2">All inventory levels are healthy.</p>
          <% } else { %>
            <div class="space-y-2">
              <% lowStockList.forEach(prod => { %>
                <div class="flex items-center justify-between p-2 rounded bg-red-50 text-red-900">
                  <span class="truncate max-w-[160px] font-medium"><%= prod.name %></span>
                  <span class="font-bold bg-red-200 text-red-800 px-2 py-0.5 rounded text-[10px]">
                    <%= prod.stock %> left
                  </span>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

        <!-- Management shortcuts -->
        <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200 space-y-2">
          <h3 class="font-bold text-gray-900 border-b pb-2 mb-3">Administrative Hub</h3>
          <a href="/admin/products" class="flex items-center justify-between p-2 rounded hover:bg-purple-50 text-gray-700 hover:text-purple-700 transition">
            <span><i class="fa-solid fa-tag text-purple-600 mr-2"></i> Manage Products</span>
            <i class="fa-solid fa-chevron-right text-[10px]"></i>
          </a>
          <a href="/admin/categories" class="flex items-center justify-between p-2 rounded hover:bg-purple-50 text-gray-700 hover:text-purple-700 transition">
            <span><i class="fa-solid fa-layer-group text-purple-600 mr-2"></i> Manage Categories</span>
            <i class="fa-solid fa-chevron-right text-[10px]"></i>
          </a>
          <a href="/admin/users" class="flex items-center justify-between p-2 rounded hover:bg-purple-50 text-gray-700 hover:text-purple-700 transition">
            <span><i class="fa-solid fa-users text-purple-600 mr-2"></i> Users & Role Assignment</span>
            <i class="fa-solid fa-chevron-right text-[10px]"></i>
          </a>
          <a href="/admin/login-activity" class="flex items-center justify-between p-2 rounded hover:bg-purple-50 text-gray-700 hover:text-purple-700 transition">
            <span><i class="fa-solid fa-user-shield text-purple-600 mr-2"></i> Authentication Audit Logs</span>
            <i class="fa-solid fa-chevron-right text-[10px]"></i>
          </a>
        </div>

      </div>

    </div>

  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
