<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow py-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
    
    <!-- Top Bar -->
    <div class="bg-white p-4 rounded-sm shadow-sm border border-gray-200 flex flex-wrap items-center justify-between gap-3 text-xs">
      <div>
        <h1 class="text-base font-bold text-gray-900">Assigned Delivery Shipments (<%= orders.length %>)</h1>
        <span class="text-gray-500">Deliveries assigned to you for dispatch and handover.</span>
      </div>

      <!-- Filters -->
      <div class="flex items-center gap-2">
        <a href="/delivery/orders?status=all" class="px-3 py-1.5 rounded border <%= currentFilter === 'all' ? 'bg-emerald-600 text-white font-bold' : 'hover:bg-gray-50' %>">
          All
        </a>
        <a href="/delivery/orders?status=active" class="px-3 py-1.5 rounded border <%= currentFilter === 'active' ? 'bg-emerald-600 text-white font-bold' : 'hover:bg-gray-50' %>">
          Active / Out for Delivery
        </a>
        <a href="/delivery/orders?status=delivered" class="px-3 py-1.5 rounded border <%= currentFilter === 'delivered' ? 'bg-emerald-600 text-white font-bold' : 'hover:bg-gray-50' %>">
          Delivered
        </a>
      </div>
    </div>

    <!-- Orders Cards / List -->
    <% if (!orders || orders.length === 0) { %>
      <div class="bg-white p-12 text-center rounded-sm border border-gray-200">
        <i class="fa-solid fa-dolly text-5xl text-gray-300 mb-3 block"></i>
        <h3 class="text-sm font-bold text-gray-700">No shipments found for this filter</h3>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% orders.forEach(order => { %>
          <div class="bg-white p-5 rounded-sm shadow-sm border border-gray-200 hover:border-emerald-500 transition space-y-3">
            
            <div class="flex items-center justify-between border-b pb-2 text-xs">
              <div>
                <span class="font-bold text-gray-900">#<%= order.orderNumber %></span>
                <span class="text-gray-400 text-[11px] block"><%= formatDate(order.createdAt) %></span>
              </div>
              <span class="text-xs font-bold px-2 py-0.5 rounded <%= order.orderStatus === 'Delivered' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
                <%= order.orderStatus %>
              </span>
            </div>

            <!-- Recipient & Address -->
            <div class="text-xs space-y-1">
              <div class="font-bold text-gray-800 flex items-center gap-1.5">
                <i class="fa-solid fa-user text-gray-400"></i> <%= order.addressSnapshot.fullName %>
              </div>
              <div class="text-gray-600 flex items-start gap-1.5">
                <i class="fa-solid fa-location-dot text-gray-400 mt-0.5"></i>
                <span><%= order.addressSnapshot.line1 %>, <%= order.addressSnapshot.city %> - <%= order.addressSnapshot.pincode %></span>
              </div>
              <div class="text-gray-700 flex items-center gap-1.5">
                <i class="fa-solid fa-phone text-emerald-600"></i>
                <a href="tel:<%= order.addressSnapshot.phone %>" class="font-bold text-emerald-700 hover:underline"><%= order.addressSnapshot.phone %></a>
              </div>
            </div>

            <!-- Amount and Items -->
            <div class="bg-gray-50 p-2.5 rounded text-xs flex items-center justify-between">
              <div>
                <span class="text-gray-500">Collect: </span>
                <span class="font-black text-gray-900"><%= formatPrice(order.totals.grandTotal) %></span>
                <span class="text-[10px] text-gray-400 block uppercase"><%= order.paymentMethod %></span>
              </div>
              <div class="text-right text-gray-500 text-[11px]">
                <%= order.items.length %> item(s) in package
              </div>
            </div>

            <!-- Actions -->
            <div class="pt-1 flex gap-2">
              <a href="/delivery/orders/<%= order._id %>" class="w-full text-center bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 rounded text-xs shadow transition">
                Manage & Update Delivery Status
              </a>
            </div>

          </div>
        <% }) %>
      </div>
    <% } %>

  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
