<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="flex-grow py-6">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    
    <div class="flex items-center justify-between">
      <a href="/delivery/orders" class="text-xs font-bold text-emerald-700 hover:underline inline-flex items-center gap-1">
        <i class="fa-solid fa-arrow-left"></i> Back to Shipments
      </a>
      <span class="text-xs text-gray-500">Order Placed: <%= formatDate(order.createdAt) %></span>
    </div>

    <!-- Status Update Form Card -->
    <div class="bg-white rounded-sm shadow-sm border border-emerald-300 p-6">
      <div class="border-b pb-4 mb-4 flex items-center justify-between">
        <div>
          <h1 class="text-lg font-bold text-gray-900">Shipment Handover #<%= order.orderNumber %></h1>
          <span class="text-xs text-gray-500">Current Status: <strong class="text-emerald-700"><%= order.orderStatus %></strong></span>
        </div>
      </div>

      <form action="/delivery/orders/<%= order._id %>/status" method="POST" class="space-y-4 text-xs">
        <div>
          <label class="block font-bold text-gray-700 mb-1">Update Shipment Status *</label>
          <select name="status" class="w-full p-2.5 border border-gray-300 rounded bg-white text-xs font-bold text-gray-800">
            <option value="Out for Delivery" <%= order.orderStatus === 'Out for Delivery' ? 'selected' : '' %>>🚚 Out for Delivery (In Van / On Bike)</option>
            <option value="Delivered" <%= order.orderStatus === 'Delivered' ? 'selected' : '' %>>✅ Delivered (Package Handed to Customer)</option>
            <option value="Undelivered" <%= order.orderStatus === 'Undelivered' ? 'selected' : '' %>>⚠️ Undelivered (Door Closed / Reschedule)</option>
          </select>
        </div>

        <div>
          <label class="block font-bold text-gray-700 mb-1">Delivery Agent Remarks / Proof Note</label>
          <input type="text" name="deliveryNotes" value="<%= order.deliveryNotes || '' %>" placeholder="e.g. Handed over to recipient, OTP confirmed, or customer asked to deliver tomorrow" class="w-full p-2.5 border rounded text-xs">
        </div>

        <% if (order.paymentMethod === 'COD' && order.paymentStatus !== 'completed') { %>
          <div class="p-3 bg-amber-50 border border-amber-200 rounded text-amber-900">
            <strong><i class="fa-solid fa-triangle-exclamation"></i> CASH ON DELIVERY:</strong> Please collect <strong><%= formatPrice(order.totals.grandTotal) %></strong> in cash or via QR prior to marking as Delivered.
          </div>
        <% } %>

        <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 px-6 rounded text-xs uppercase tracking-wider shadow">
          Save Delivery Status
        </button>
      </form>
    </div>

    <!-- Customer & Destination Details -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white p-5 rounded-sm border border-gray-200 text-xs space-y-2">
        <h3 class="font-bold text-gray-400 uppercase tracking-wider text-[10px]">Customer Contact</h3>
        <div class="font-bold text-sm text-gray-900"><%= order.addressSnapshot.fullName %></div>
        <div class="text-gray-700">Phone: <a href="tel:<%= order.addressSnapshot.phone %>" class="font-bold text-blue-600 underline"><%= order.addressSnapshot.phone %></a></div>
        <div class="text-gray-500">Email: <%= order.userId ? order.userId.email : 'N/A' %></div>
      </div>

      <div class="bg-white p-5 rounded-sm border border-gray-200 text-xs space-y-2">
        <h3 class="font-bold text-gray-400 uppercase tracking-wider text-[10px]">Delivery Address</h3>
        <p class="text-gray-700 leading-relaxed">
          <%= order.addressSnapshot.line1 %>, <%= order.addressSnapshot.line2 ? order.addressSnapshot.line2 + ', ' : '' %><br>
          <%= order.addressSnapshot.city %>, <%= order.addressSnapshot.state %> - <strong><%= order.addressSnapshot.pincode %></strong>
        </p>
      </div>
    </div>

    <!-- Package Contents -->
    <div class="bg-white p-5 rounded-sm border border-gray-200 text-xs">
      <h3 class="font-bold text-gray-400 uppercase tracking-wider text-[10px] mb-3">Package Contents (<%= order.items.length %> items)</h3>
      <div class="divide-y divide-gray-100">
        <% order.items.forEach(item => { %>
          <div class="py-2 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <img src="<%= item.image %>" class="w-10 h-10 object-contain border rounded p-0.5">
              <span class="font-medium text-gray-800"><%= item.name %></span>
            </div>
            <div class="text-gray-500">Qty: <strong><%= item.quantity %></strong></div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Delivery History / Log of status updates -->
    <div class="bg-white p-5 rounded-sm border border-gray-200 text-xs">
      <h3 class="font-bold text-gray-400 uppercase tracking-wider text-[10px] mb-2">Audit History for this Order</h3>
      <div class="space-y-1.5 text-gray-600">
        <% order.statusTimeline.slice().reverse().forEach(evt => { %>
          <div class="flex justify-between border-b border-gray-50 py-1">
            <span><strong><%= evt.status %></strong>: <%= evt.message %></span>
            <span class="text-gray-400"><%= formatDate(evt.timestamp) %></span>
          </div>
        <% }) %>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
</body>
</html>
